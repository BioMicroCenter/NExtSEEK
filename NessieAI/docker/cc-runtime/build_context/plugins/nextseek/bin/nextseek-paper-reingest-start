#!/bin/sh
# nextseek-paper-reingest-start — paper reingest step 1: check that a paper's Methods
# and Data Availability can be read and start a background run that reads the paper,
# its supplement and its deposits. Curators only. Writes nothing to SEEK.
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/_nextseek_common.sh"

PAPER=""
PROJECT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --paper) PAPER="$2"; shift 2 ;;
    --paper=*) PAPER="${1#--paper=}"; shift ;;
    --project) PROJECT="$2"; shift 2 ;;
    --project=*) PROJECT="${1#--project=}"; shift ;;
    --help)
      echo "Usage: nextseek-paper-reingest-start --paper \"<pmid|doi|url|attached file name>\" [--project <SEEK project id>]"
      echo ""
      echo "Checks the paper can be read (Europe PMC, or a PDF the curator attached)"
      echo "and starts a background run that reads it, its supplement and its"
      echo "deposits. Returns at once. If the reply says needs_pdf, ask the curator"
      echo "to attach the PDF and call again with its file name."
      exit 0
      ;;
    *) nextseek_die 3 "unknown arg: $1" ;;
  esac
done
[ -n "$PAPER" ] || nextseek_die 3 "missing --paper"

if [ -n "$PROJECT" ]; then
  exec python "$SCRIPT_DIR/_nextseek_runner.py" --agent paper-reingest-start \
    --paper "$PAPER" --project "$PROJECT"
fi

exec python "$SCRIPT_DIR/_nextseek_runner.py" --agent paper-reingest-start --paper "$PAPER"
