#!/bin/sh
# nextseek-build-upload-xlsx — render NExtSEEK 4-sheet upload workbook(s).
# Current: --manifest-id <id> [--mode {new,update}] — the server loads its own copy
# of the run-harvest manifest and derives every row itself, so no measured value
# round-trips through the model. Legacy: --rows '<json array>' for a caller that
# still composes rows directly. Either way, returns the workbook(s) as downloadable
# artifacts for review. Does NOT upload to NExtSEEK — the user reviews and uploads.
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/_nextseek_common.sh"

MANIFEST_ID=""
MODE=""
ROWS=""
EXISTING=""
while [ $# -gt 0 ]; do
  case "$1" in
    --manifest-id) MANIFEST_ID="$2"; shift 2 ;;
    --manifest-id=*) MANIFEST_ID="${1#--manifest-id=}"; shift ;;
    --mode) MODE="$2"; shift 2 ;;
    --mode=*) MODE="${1#--mode=}"; shift ;;
    --rows) ROWS="$2"; shift 2 ;;
    --rows=*) ROWS="${1#--rows=}"; shift ;;
    --existing-parent-uids) EXISTING="$2"; shift 2 ;;
    --existing-parent-uids=*) EXISTING="${1#--existing-parent-uids=}"; shift ;;
    --help)
      echo "Usage: nextseek-build-upload-xlsx --manifest-id <id> [--mode {new,update}]"
      echo "       nextseek-build-upload-xlsx --rows '<json array>' [--existing-parent-uids <csv>]"
      echo ""
      echo "manifest-id form (current): <id> comes from nextseek-run-harvest's result."
      echo "  --mode new (default) renders the analysis children; --mode update renders"
      echo "  the D.SEQ QC backfill."
      echo ""
      echo "rows form (legacy): each row is"
      echo "  {\"SampleType\": \"A.*\", \"json_metadata\": {\"Parent\": \"<UID>\", ...}, \"assay_ids\": [..]}."
      echo "  Pass the input cohort's UIDs via --existing-parent-uids so Parent links QA cleanly."
      echo ""
      echo "Either way, renders one 4-sheet upload workbook per sample type for review."
      exit 0
      ;;
    *) nextseek_die 3 "unknown arg: $1" ;;
  esac
done

if [ -n "$MANIFEST_ID" ]; then
  exec python "$SCRIPT_DIR/_nextseek_runner.py" --agent build-upload-xlsx \
    --manifest-id "$MANIFEST_ID" --mode "${MODE:-new}"
fi
[ -n "$ROWS" ] || nextseek_die 3 "missing --manifest-id or --rows"

exec python "$SCRIPT_DIR/_nextseek_runner.py" --agent build-upload-xlsx --rows "$ROWS" --existing-parent-uids "$EXISTING"
