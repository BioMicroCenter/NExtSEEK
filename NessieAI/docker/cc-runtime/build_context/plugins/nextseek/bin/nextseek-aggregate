#!/bin/sh
# nextseek-aggregate — counts and breakdowns inside the user's projects, one call.
# The question alone, or 1 to 4 plain-language parts run in parallel on the server.
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/_nextseek_common.sh"

QUERY=""
PARTS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --query) QUERY="$2"; shift 2 ;;
    --query=*) QUERY="${1#--query=}"; shift ;;
    --parts) PARTS="$2"; shift 2 ;;
    --parts=*) PARTS="${1#--parts=}"; shift ;;
    --help)
      echo "Usage: nextseek-aggregate --query \"<whole question>\" [--parts '[\"<part 1>\", \"<part 2>\"]']"
      echo "  --query  the whole question, in plain words"
      echo "  --parts  a JSON array of 1 to 4 sub-questions, one per independent number or breakdown"
      exit 0
      ;;
    *) nextseek_die 3 "unknown arg: $1" ;;
  esac
done
[ -n "$QUERY" ] || nextseek_die 3 "missing --query"

exec python "$SCRIPT_DIR/_nextseek_runner.py" --agent aggregate --query "$QUERY" --parts "$PARTS"
