#!/bin/sh
# nextseek-graph — graph/Cypher lineage queries.
# Plan B · T7.
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/_nextseek_common.sh"

QUERY=""
PLAN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --query) QUERY="$2"; shift 2 ;;
    --query=*) QUERY="${1#--query=}"; shift ;;
    --plan) PLAN="$2"; shift 2 ;;
    --plan=*) PLAN="${1#--plan=}"; shift ;;
    --help)
      echo "Usage: nextseek-graph --query \"<text>\" [--plan '<json>']"
      echo "  --plan   {\"intent_summary\": \"...\", \"filters\": {\"sampletype_code\", \"assay_codes\", \"keywords\", \"uids\", \"lab_codes\"}, \"notes\": \"...\"}"
      exit 0
      ;;
    *) nextseek_die 3 "unknown arg: $1" ;;
  esac
done
[ -n "$QUERY" ] || nextseek_die 3 "missing --query"

exec python "$SCRIPT_DIR/_nextseek_runner.py" --agent graph --query "$QUERY" --plan "$PLAN"
