// luria.config — local reference genomes for nf-core on MIT Luria.
// Generated from luria.run_script.LURIA_GENOMES. The params.genomes MAP resolution is
// unreliable in Nextflow (getGenomeAttribute returns the value but the workflow assertion
// sees empty), so submit_to_luria ALSO passes explicit --fasta/--gtf on the CLI — that is
// what actually wires the references. This map is kept for --genome key identity.

params {
    genomes {
        'GRCh38' {
            fasta = '/net/x/refs/GRCh38.primary_assembly.genome.fa.gz'
            gtf   = '/net/x/refs/gencode.v46.basic.annotation.gtf.gz'
        }
        'GRCm39' {
            fasta = '/net/x/refs/GRCm39.primary_assembly.genome.fa.gz'
            gtf   = '/net/x/refs/gencode.vM39.basic.annotation.gtf.gz'
        }
        'Mfas6.0' {
            fasta = '/net/x/refs/Macaca_fascicularis.Macaca_fascicularis_6.0.dna.toplevel.fa.gz'
            gtf   = '/net/x/refs/Macaca_fascicularis.Macaca_fascicularis_6.0.116.gtf.gz'
        }
        'Mmul_10' {
            fasta = '/net/x/refs/Macaca_mulatta.Mmul_10.dna.toplevel.fa.gz'
            gtf   = '/net/x/refs/Macaca_mulatta.Mmul_10.116.gtf.gz'
        }
    }
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

process {
    withName: '.*:SIMPLEAF_QUANT' {
        ext.args = '-r cr-like --knee'
    }
}
