{
  "_name": "probe-2026-10-03-r4-dev-routing - the routing smoke after round 4 is pushed to dev",
  "_why": "About 12 questions on what round 4 touched directly: the three kept REST uses, an SOP list on the graph, catalog counts, a how-to first turn, caller identity, a follow-up that stays NS, a CC work request and a lab named like an entity. Roughly 12 turns, one cheap pass per login, PAID: needs the operator's go. Dev only.",
  "_instance_warning": "Dev's numbers differ from production's. The two assay-kind numbers (75 with samples, 8 without) are dev's, measured for the 3 Oct review; re-pin them with pin_probe_truths.py on any other box. Every other expected value is a per-box check named in _by_box, not a number.",
  "_run": "Run the file twice on the same box, once per login (cli --user/--password): cases tagged login:both on each login, login:member only on the NON-ADMIN login. Judge a case only on the login its tag names. Fill the FILL markers first (each is listed in _fill; replace every occurrence in a COPY with sed), keep the filled copy out of git: it holds real ids.",
  "_fill": {
    "LAB_IS_ENTITY": "a lab name from the lab catalog that is ALSO an investigation title or alias (or a project) on this box",
    "SOP_TITLE": "any SOP title the login can see: the protocol_title of a DERIVED_FROM edge, or SELECT title FROM seek_production.sops LIMIT 1 for an admin",
    "UID_IN_LOGIN_PROJECT": "a sample UID inside one of the LOGIN's projects (run once per login): MATCH (s:Sample) WHERE <login project id> IN s.project_ids RETURN s.uuid LIMIT 1"
  },
  "_by_box": "Numbers not pinned in a criterion are checked per box and login on the day from the same source the case's _why names (a REST row count, the box's context json, a scoped Cypher). Never copy a number from another box.",
  "_measure": {
    "r4d.assay_kinds_split": {
      "locals": [
        75,
        8
      ],
      "mode": "each",
      "cypher": [
        "MATCH (a:Assay) WHERE EXISTS { (a)-[:INPUT_TO|OUTPUT_OF]-(:Sample) } RETURN count(a) AS n",
        "MATCH (a:Assay) WHERE NOT EXISTS { (a)-[:INPUT_TO|OUTPUT_OF]-(:Sample) } RETURN count(a) AS n"
      ]
    }
  },
  "families": {
    "retrieval_path_selection": {
      "description": "R4 smoke (dev)",
      "variants": [
        {
          "family": "retrieval_path_selection",
          "id": "r4d.sops_list",
          "name": "SOP list or search goes to the graph (ruling 9)",
          "_why": "An SOP is the protocol recorded in sample metadata, so listing or searching them is a graph question; the sops endpoint is for downloading. Per box: the distinct protocol titles the login can see.",
          "tags": [
            "nessie",
            "probe",
            "full",
            "login:both"
          ],
          "requires_env": [],
          "turns": [
            {
              "label": "main",
              "query": "What SOPs are on file?",
              "pass_criteria": [
                {
                  "field": "route",
                  "op": "eq",
                  "value": "nextseek_query"
                },
                {
                  "field": "parser_plan.mode",
                  "op": "eq",
                  "value": "graph_query"
                },
                {
                  "field": "neo4j_ok",
                  "op": "true",
                  "value": null
                },
                {
                  "field": "graph_cypher",
                  "op": "nonempty",
                  "value": null
                },
                {
                  "field": "graph_cypher",
                  "op": "matches_re",
                  "value": "(?i)protocol"
                },
                {
                  "field": "last_reply",
                  "op": "nonempty",
                  "value": null
                },
                {
                  "field": "last_reply",
                  "op": "matches_re",
                  "value": "(?is)\\A(?!.*(\\bfirst \\d+\\b))"
                },
                {
                  "field": "api_plan.endpoint",
                  "op": "matches_re",
                  "value": "^(?!/nextseek_api/sops/)"
                }
              ]
            }
          ]
        },
        {
          "family": "retrieval_path_selection",
          "id": "r4d.sop_download",
          "name": "Downloading a named SOP is the kept REST use",
          "_why": "REST is for finding people, downloading SOPs and retrieving samples by UID. The title is filled per box.",
          "tags": [
            "nessie",
            "probe",
            "full",
            "login:both"
          ],
          "requires_env": [],
          "turns": [
            {
              "label": "main",
              "query": "Give me the file for the SOP titled __FILL:SOP_TITLE__",
              "pass_criteria": [
                {
                  "field": "route",
                  "op": "eq",
                  "value": "nextseek_query"
                },
                {
                  "field": "api_plan.endpoint",
                  "op": "matches_re",
                  "value": "/nextseek_api/sops/"
                },
                {
                  "field": "last_reply",
                  "op": "nonempty",
                  "value": null
                }
              ]
            }
          ]
        }
      ]
    },
