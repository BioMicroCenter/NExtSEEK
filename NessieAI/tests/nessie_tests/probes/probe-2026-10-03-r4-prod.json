              "query": "What SOPs are on file?",
              "pass_criteria": [
                {
                  "field": "route",
                  "op": "eq",
                  "value": "nextseek_query"
                },
                {
                  "field": "parser_plan.mode",
                  "op": "eq",
                  "value": "graph_query"
                },
                {
                  "field": "neo4j_ok",
                  "op": "true",
                  "value": null
