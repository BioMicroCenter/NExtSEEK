{
  "_name": "probe-2026-10-03-r4-prod - the comprehensive production smoke after round 4",
  "_why": "Every fix in the round and its siblings: DOI and PMID on samples (and a number no Study carries), distinct counts, same-assay (anchored and unanchored), lab names that are projects, investigations or aliases (and a lab that is none), membership on the non-admin login, holding-study notes with a control, the routing set (three kept REST uses, SOP on the graph, catalog and graph counts, how-to first turns, a follow-up that stays NS, CC work and Excel export), and the A4 aliases on the non-admin login. Read-only: no writing family. PAID: needs the operator's go; run it only after the dev routing smoke is green.",
  "_instance_warning": "Production keys are computed on the day. The one pinned number is the Griffith project's distinct sample count (3,401, the graph 7 IN project_ids, measured read-only on production 2026-10-03); re-pin it with pin_probe_truths.py before the run.",
  "_run": "Run the file twice on the same box, once per login (cli --user/--password): cases tagged login:both on each login, login:member only on the NON-ADMIN login, login:admin only on the ADMIN login. Judge a case only on the login its tag names. Fill the FILL markers first (each is listed in _fill; replace every occurrence in a COPY with sed), keep the filled copy out of git: it holds real ids.",
  "_fill": {
    "DOI": "a DOI that some Study carries, same query on st.DOI",
    "LAB_ONLY": "a lab name from the lab catalog that is none of: a project, an investigation, or an alias of either on this box",
    "OTHER_UNPUBLISHED_STUDY": "a second study whose title ends in Unpublished: MATCH (st:Study) WHERE toLower(st.title) ENDS WITH 'unpublished' RETURN st.title",
    "PAPER_STUDY": "a study that is a paper: MATCH (st:Study) WHERE NOT toLower(st.title) ENDS WITH 'unpublished' RETURN st.title LIMIT 1",
    "PMID": "a PMID that some Study carries: MATCH (st:Study) WHERE st.PMID IS NOT NULL RETURN st.PMID LIMIT 1 (check the property name against docs/neo4j-schema.md)",
    "PMID_NO_STUDY": "digits that no Study carries: pick a PMID-shaped number and confirm MATCH (st:Study) WHERE st.PMID = '<n>' RETURN count(st) is 0",
    "SOP_TITLE": "any SOP title the login can see: the protocol_title of a DERIVED_FROM edge, or SELECT title FROM seek_production.sops LIMIT 1 for an admin",
    "UID_IN_LOGIN_PROJECT": "a sample UID inside one of the LOGIN's projects (run once per login): MATCH (s:Sample) WHERE <login project id> IN s.project_ids RETURN s.uuid LIMIT 1",
    "UID_LINEAGE": "a UID with direct children: MATCH (c:Sample)-[:DERIVED_FROM]->(p:Sample) RETURN p.uuid, count(c) AS n ORDER BY n DESC SKIP 5 LIMIT 1 (a mid-size parent); keep the count n for the check",
    "UID_WITH_ASSAY": "a UID that went through an assay run: MATCH (s:Sample)-[:INPUT_TO|OUTPUT_OF]->(a:Assay) RETURN s.uuid LIMIT 1"
  },
  "_by_box": "Numbers not pinned in a criterion are checked per box and login on the day from the same source the case's _why names (a REST row count, the box's context json, a scoped Cypher). Never copy a number from another box.",
  "_measure": {
    "r4p.griffith_distinct_count": {
      "locals": [
        3401
      ],
      "mode": "each",
      "cypher": [
        "MATCH (s:Sample) WHERE 7 IN s.project_ids RETURN count(DISTINCT s) AS n"
      ]
    }
  },
