{
  "map_version": 1,
  "pipeline": "nf-core/differentialabundance",
  "applies_to_versions": ">=1.4,<2",
  "accepts_parent_types": ["D.SEQ"],
  "harvest_globs": [],
  "derived_metrics": [],
  "outputs": [
    {
      "glob": "tables/processed_abundance/all.normalised_counts.tsv",
      "sample_type": "A.GEX",
      "assay": "Gene Expression Analysis",
      "cardinality": "per_run",
      "primary_data": true,
      "include_provenance": true,
      "attributes": {
        "Matrix": "normalised_counts",
        "Name": "@gex_name",
        "Scientist": "@nextseek_user",
        "Lab": "@lab",
        "SampleCreationDate": "@run_date",
        "DataType": "TSV"
      }
    },
    {
      "glob": "tables/differential/*.deseq2.results.tsv",
      "sample_type": "A.GEX",
      "assay": "Gene Expression Analysis",
      "cardinality": "per_file",
      "primary_data": true,
      "include_provenance": true,
      "attributes": {
        "Matrix": "deseq2_results",
        "Contrast": "@file_stem",
        "Name": "@gex_name",
        "Scientist": "@nextseek_user",
        "Lab": "@lab",
        "SampleCreationDate": "@run_date",
        "DataType": "TSV"
      }
    },
    {
      "glob": "tables/differential/*.limma.results.tsv",
      "sample_type": "A.GEX",
      "assay": "Gene Expression Analysis",
      "cardinality": "per_file",
      "primary_data": true,
      "include_provenance": true,
      "attributes": {
        "Matrix": "limma_results",
        "Contrast": "@file_stem",
        "Name": "@gex_name",
        "Scientist": "@nextseek_user",
        "Lab": "@lab",
        "SampleCreationDate": "@run_date",
        "DataType": "TSV"
      }
    }
  ],
  "provenance_attributes": {
    "Pipeline": "$pipeline.name",
    "PipelineVersion": "$pipeline.version",
    "Link_QualityControl": "$outputs.differentialabundance_report_html"
  },
  "qc_attributes": {
    "Link_QC": {
      "from": "$outputs.multiqc_report_html", "target": "D.SEQ",
      "datatype": "string", "provenance": "seed"
    },
    "Genome": {
      "from": "$params.genome", "target": "D.SEQ", "datatype": "string",
      "provenance": "seed"
    }
  },
  "deliberately_unmapped": []
}
