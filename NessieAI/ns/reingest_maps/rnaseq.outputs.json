{
  "map_version": 2,
  "pipeline": "nf-core/rnaseq",
  "applies_to_versions": ">=3.14,<4",
  "accepts_parent_types": ["D.SEQ"],

  "harvest_globs": [
    "{star_salmon,star_rsem,hisat2}/log/*.Log.final.out",
    "{star_salmon,star_rsem,hisat2}/samtools_stats/*.{flagstat,idxstats,stats}",
    "{star_salmon,star_rsem,hisat2}/picard_metrics/*.MarkDuplicates.metrics.txt",
    "{star_salmon,star_rsem,hisat2}/rseqc/read_distribution/*.read_distribution.txt",
    "{star_salmon,star_rsem,hisat2}/rseqc/infer_experiment/*.infer_experiment.txt",
    "{star_salmon,star_rsem,hisat2}/qualimap/*/rnaseq_qc_results.txt",
    "{star_salmon,star_rsem,hisat2}/featurecounts/*.featureCounts.txt.summary",
    "{star_salmon,star_rsem,hisat2}/contaminants/kraken2/kraken_reports/*.kraken2.report.txt",
    "sortmerna/*.sortmerna.log",
    "trimgalore/*_trimming_report.txt",
    "{star_salmon,salmon,star_rsem,kallisto}/*.merged.tx2gene.tsv"
  ],
  "inventory_globs": ["**/*.merged.gene_counts.tsv", "**/*.merged.gene_tpm.tsv", "**/*.merged.transcript_counts.tsv", "**/*.merged.transcript_tpm.tsv",
                      "**/star_salmon/*/quant.sf", "**/salmon/*/quant.sf"],

  "derived_metrics": [
    "cds_pct", "utr_pct", "intron_pct", "intergenic_pct",
    "exon_intron_ratio", "exon_intergenic_ratio", "sense_antisense_ratio",
    "genes_detected", "genes_detected_percent", "top30_count_percent",
    "unaligned_reads",
    "qualimap_aligned_reads", "exonic_fraction", "intronic_fraction", "intergenic_fraction",
    "raw_reads_r1", "raw_reads_r2"
  ],

  "outputs": [
    { "id": "aln", "candidates": ["{star_salmon,star_rsem,hisat2}/*.markdup.sorted.bam"],
      "sample_type": "A.ALN", "assay": "Genome Alignment", "cardinality": "per_sample", "primary_data": true,
      "companions": [{"glob": "{star_salmon,star_rsem,hisat2}/*.markdup.sorted.bam.bai"}],
      "attributes": { "DataType": "BAM",
                      "Name": "@fastq_stem", "Scientist": "@nextseek_user",
                      "SampleCreationDate": "@run_date",
                      "Aligner": "$params.aligner", "Genome": "$params.genome",
                      "Software": "$software_versions.star",
                      "TotalReads": "$derived.total_reads",
                      "NumAligned": "$derived.uniquely_mapped_reads",
                      "MappedPercent": ["$metrics.star-uniquely_mapped_percent",
                                        "$metrics.samtools_stats-reads_mapped_percent"],
                      "STARMappedPercent": "$metrics.star-mapped_percent",
                      "rRNAPercent": "$metrics.custom_content_biotype_counts-percent_rRNA",
                      "DuplicationPercent": "$metrics.picard_mark_duplicates-PERCENT_DUPLICATION",
                      "DupRadarIntercept": "$metrics.custom_content_dupradar-dupRadar_intercept",
                      "5_3UTR": ["$metrics.qualimap_rnaseq-5_3_bias",
                                 "$metrics.QualiMap_mqc-generalstats-qualimap-5_3_bias"],
                      "TrimmedBasesPercent_R1": ["$metrics.cutadapt-percent_trimmed@R1",
                                                 "$metrics.cutadapt-percent_trimmed"],
                      "TrimmedBasesPercent_R2": "$metrics.cutadapt-percent_trimmed@R2" } },

    { "id": "gene_counts", "candidates": ["{star_salmon,star_rsem}/*.merged.gene_counts.tsv", "{salmon,kallisto}/*.merged.gene_counts.tsv"],
      "sample_type": "A.GEX", "assay": "Gene Expression Analysis", "cardinality": "per_run", "primary_data": true,
      "include_provenance": true,
      "attributes": { "Matrix": "gene_counts",
                      "Name": "@gex_name", "Scientist": "@nextseek_user", "Lab": "@lab",
                      "SampleCreationDate": "@run_date", "DataType": "TSV" } },

    { "id": "quant", "candidates": ["star_salmon/*/quant.sf", "salmon/*/quant.sf"],
      "sample_type": "A.GEX", "assay": "Gene Expression Analysis", "cardinality": "per_sample",
      "primary_data": true, "optional": true, "include_provenance": true,
      "attributes": { "Matrix": "transcript_quant", "DataType": "TSV",
                      "Name": "@fastq_stem", "Scientist": "@nextseek_user", "Lab": "@lab",
                      "SampleCreationDate": "@run_date",
                      "PseudoalignedPercent": "$metrics.salmon-percent_mapped",
                      "SalmonLibraryType": "$metrics.salmon-library_types",
                      "StrandMappingBias": "$metrics.salmon-strand_mapping_bias",
                      "TrimmedBasesPercent_R1": ["$metrics.cutadapt-percent_trimmed@R1",
                                                 "$metrics.cutadapt-percent_trimmed"],
                      "TrimmedBasesPercent_R2": "$metrics.cutadapt-percent_trimmed@R2" } }
  ],

  "provenance_attributes": {
    "Pipeline":             "$pipeline.name",
    "PipelineVersion":      "$pipeline.version",
    "Aligner":              "$params.aligner",
    "Pseudo_Aligner":       "$params.pseudo_aligner",
    "ReferenceGenome":      "$params.genome",
    "Link_ReferenceGenome": "@genome_path",
    "AnnotationGTF":        "@gtf_path",
    "Link_GTF":             "@gtf_path",
    "Link_QualityControl":  "$outputs.multiqc_report_html",
    "DESeqFile":            "$outputs.deseq2_dds_rdata",
    "DESeqFile_Link":       "$outputs.deseq2_dds_rdata"
  },

  "qc_attributes": {
    "UnalignedReads":       { "from": "$derived.unaligned_reads", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed",
                              "note": "sum of STAR's three \"unmapped:\" lines in <sample>.Log.final.out (too many mismatches + too short + other). NOT total-unique-multi: that also counts \"mapped to too many loci\", which STAR files under MULTI-MAPPING READS because those reads did align, just to more places than the threshold allows."
                            },
    "CDSPercent":           { "from": "$derived.cds_pct",
                              "target": "D.SEQ", "datatype": "number", "provenance": "seed" },
    "UTRPercent":           { "from": "$derived.utr_pct",
                              "target": "D.SEQ", "datatype": "number",
                              "note": "5'UTR + 3'UTR summed by the harvester",
                              "provenance": "seed" },
    "IntronPercent":        { "from": "$derived.intron_pct",
                              "target": "D.SEQ", "datatype": "number", "provenance": "seed" },
    "IntergenicPercent":    { "from": "$derived.intergenic_pct",
                              "target": "D.SEQ", "datatype": "number", "provenance": "seed" },
    "ExonIntronRatio":      { "from": "$derived.exon_intron_ratio", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "ExonIntergenicRatio":  { "from": "$derived.exon_intergenic_ratio", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "SenseAntisenseRatio":  { "from": "$derived.sense_antisense_ratio", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "GenesDetected":        { "from": "$derived.genes_detected", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "GenesDetectedPercent": { "from": "$derived.genes_detected_percent", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "Top30CountPercent":    { "from": "$derived.top30_count_percent", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "Link_Contamination":   { "from": "$outputs.kraken2_report", "target": "D.SEQ",
                              "datatype": "string", "provenance": "seed" },
    "Link_QC":              { "from": "$outputs.multiqc_report_html", "target": "D.SEQ",
                              "datatype": "string", "provenance": "seed" },
    "Genome":               { "from": "$params.genome", "target": "D.SEQ",
                              "datatype": "string", "provenance": "seed" },
    "GCPercent":            { "from": "fastqc_raw-percent_gc", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": ["fastqc_raw-percent_gc@R1", "fastp-after_filtering_gc_content"],
                              "note": "FastQC on the raw reads; single-end runs write it on the sample row, paired-end on <sample>_1 (@R1)",
                              "provenance": "seed" },
    "F_bp":                 { "from": "fastqc_raw-avg_sequence_length@R1", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": ["fastqc_raw-avg_sequence_length", "fastp-before_filtering_read1_mean_length"],
                              "note": "mean read-1 length (FastQC per-read row, else the single-end sample row)",
                              "provenance": "seed" },
    "R_bp":                 { "from": "fastqc_raw-avg_sequence_length@R2", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": ["fastp-before_filtering_read2_mean_length"],
                              "note": "mean read-2 length; paired-end only",
                              "provenance": "seed" },
    "MultimappedPercent":   { "from": "$derived.multimapped_pct", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "STAR's % of reads mapped to multiple loci, from Log.final.out's counts",
                              "provenance": "seed" },
    "Strandedness":         { "from": "$derived.strandedness", "target": "D.SEQ",
                              "datatype": "string",
                              "note": "forward, reverse or unstranded by nf-core's rule on RSeQC infer_experiment; blank when undetermined",
                              "provenance": "seed" },
    "MismatchPercent":      { "from": "samtools_stats-error_rate", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "MultiQC writes samtools' error rate as a percentage",
                              "provenance": "seed" },
    "QualimapAlignedReads": { "from": "$derived.qualimap_aligned_reads", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "Qualimap rnaseq's aligned reads (pairs counted once), exact: MultiQC prints it in millions",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "ExonicFraction":       { "from": "$derived.exonic_fraction", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "Qualimap's exonic count over exonic + intronic + intergenic (0 to 1)",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "IntronicFraction":     { "from": "$derived.intronic_fraction", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "Qualimap's intronic count over exonic + intronic + intergenic (0 to 1)",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "IntergenicFraction":   { "from": "$derived.intergenic_fraction", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "Qualimap's intergenic count over exonic + intronic + intergenic (0 to 1)",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "RawSeqDuplicationPercent_R1": { "from": "fastqc_raw-percent_duplicates@R1", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": ["fastqc_raw-percent_duplicates"],
                              "note": "FastQC's sequence duplication on raw read 1 (single-end: the sample row); sequence-based, unlike DuplicationPercent",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "RawSeqDuplicationPercent_R2": { "from": "fastqc_raw-percent_duplicates@R2", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "FastQC's sequence duplication on raw read 2; paired-end only",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "GCPercent_R1":         { "from": "fastqc_raw-percent_gc@R1", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": ["fastqc_raw-percent_gc"],
                              "note": "FastQC GC on raw read 1 (single-end: the sample row)",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "GCPercent_R2":         { "from": "fastqc_raw-percent_gc@R2", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "FastQC GC on raw read 2; paired-end only",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "RawReads_R1":          { "from": "$derived.raw_reads_r1", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "reads in the raw read 1 FASTQ, exact: MultiQC prints FastQC's total in millions",
                              "provenance": "rnaseq QC review 2026-11-20" },
    "RawReads_R2":          { "from": "$derived.raw_reads_r2", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "reads in the raw read 2 FASTQ, exact; paired-end only",
                              "provenance": "rnaseq QC review 2026-11-20" }
  },

  "deliberately_unmapped": [
    { "key": "star-total_reads",
      "why": "MultiQC prints it in millions. TotalReads reads the exact count from the STAR log ($derived.total_reads)." },
    { "key": "star-uniquely_mapped",
      "why": "MultiQC prints it in millions. NumAligned reads the exact count from the STAR log ($derived.uniquely_mapped_reads)." },
    { "key": "samtools_stats-raw_total_sequences",
      "why": "In millions, and it counts BAM records (both mates of a pair), not reads, so it is no stand-in for TotalReads." },
    { "key": "strandedness_inferred",
      "why": "Strandedness is filled from $derived.strandedness (RSeQC infer_experiment, nf-core's rule), so this key adds nothing." },
    { "key": "star-multimapped",
      "why": "MultiQC prints it in millions. MultimappedPercent is computed from the STAR log's exact counts ($derived.multimapped_pct)." },
    { "key": "ReadLanePct",
      "why": "Meaningful only for multi-run samples; nf-core concatenates before QC, so per-lane percentages are not recoverable." },
    { "key": "20mers", "why": "No nf-core/rnaseq equivalent." },
    { "key": "MaxReads", "why": "A sequencer capacity figure, not a pipeline output." },
    { "key": "qualimap_rnaseq-reads_aligned_overlapping_exon",
      "why": "Qualimap's count, in millions, of intronic or intergenic reads that also overlap an exon. A boundary case of the region split already recorded from RSeQC read_distribution; D.SEQ has no attribute for it and does not need one." },
    { "key": "star-mapped",
      "why": "STAR's uniquely mapped plus multimapped reads, in millions (MultiQC adds the two). NumAligned holds the exact uniquely mapped count from the STAR log; the multimapped share belongs in its own percentage, not in this sum." },
    { "key": "salmon-num_mapped",
      "why": "Salmon's pseudo-mapped fragment count, in millions. Alignment is already recorded from the STAR log: TotalReads, NumAligned and MappedPercent." },
    { "key": "salmon-compatible_fragment_ratio",
      "why": "The share of Salmon's mappings consistent with the library type it used: a check on that call, not a property of the sample. Strandedness records the library type itself." },
    { "key": "samtools_flagstat-flagstat_total",
      "why": "In millions, and it counts BAM records (both mates, plus secondary and supplementary alignments), not reads, so it is no stand-in for TotalReads." },
    { "key": "samtools_flagstat-mapped_passed",
      "why": "Mapped BAM records in millions, counting each mate and every secondary alignment. NumAligned holds the exact uniquely mapped read count from the STAR log." },
    { "key": "samtools_flagstat-mapped_passed_pct",
      "why": "Mapped BAM records as a share of all records, not of reads; it sits near 100 on STAR's BAMs, and MappedPercent already holds STAR's own mapped share." },
    { "key": "samtools_stats-reads_mapped",
      "why": "In millions, and it counts mapped BAM records (each mate of a pair), not reads. NumAligned holds the exact uniquely mapped count from the STAR log." },
    { "key": "samtools_stats-non_primary_alignments",
      "why": "Secondary and supplementary BAM records, in millions: extra records for multimapped reads, which MultimappedPercent already records from the STAR log." },
    { "key": "samtools_stats-reads_properly_paired_percent",
      "why": "Sits near 100 on STAR's paired-end BAMs and is absent for single-end data, so it tells samples apart by nothing." },
    { "key": "rseqc_bam_stat-proper_pairs_percent",
      "why": "RSeQC bam_stat's proper pairs among uniquely mapped reads, divided by every BAM record, so its parts count different things. The properly-paired share is not recorded from samtools either." },
    { "key": "samtools_stats-reads_MQ0_percent",
      "why": "STAR gives MAPQ 0 to reads mapped to more than four loci, so this is a slice of the multimapping that MultimappedPercent already records." },
    { "key": "samtools_stats-insert_size_average",
      "why": "Measured on spliced alignments, so introns inflate it far past the real fragment length; it is not a library property worth recording." },
    { "key": "fastqc_raw-median_sequence_length",
      "why": "Same as the average length; hidden when samples agree within 10 bp." },
    { "key": "fastqc_raw-percent_fails",
      "why": "Share of FastQC modules that failed: a report summary, not a measurement." },
    { "key": "fastqc_trimmed-percent_duplicates", "why": "Post-trim repeat of the raw FastQC values." },
    { "key": "fastqc_trimmed-percent_gc", "why": "Post-trim repeat of the raw FastQC values." },
    { "key": "fastqc_trimmed-avg_sequence_length", "why": "Post-trim repeat of the raw FastQC values." },
    { "key": "fastqc_trimmed-median_sequence_length", "why": "Post-trim repeat of the raw FastQC values." },
    { "key": "fastqc_trimmed-percent_fails", "why": "Post-trim repeat of the raw FastQC values." },
    { "key": "fastqc_trimmed-total_sequences", "why": "Post-trim repeat of the raw FastQC values." },
    { "key": "kraken2-pct_unclassified",
      "why": "Kraken2's unclassified share of the reads STAR left unaligned, not a contamination percentage of the library. D.SEQ ContamPercent is the in-house QC measurement and reingest does not write it; no attribute was approved for the Kraken2 share (#181)." }
  ]
}
