{
  "map_version": 1,
  "pipeline": "nf-core/rnaseq",
  "applies_to_versions": ">=3.14,<4",

  "harvest_globs": [
    "{star_salmon,star_rsem,hisat2}/log/*.Log.final.out",
    "{star_salmon,star_rsem,hisat2}/samtools_stats/*.{flagstat,idxstats,stats}",
    "{star_salmon,star_rsem,hisat2}/picard_metrics/*.MarkDuplicates.metrics.txt",
    "{star_salmon,star_rsem,hisat2}/rseqc/read_distribution/*.read_distribution.txt",
    "{star_salmon,star_rsem,hisat2}/rseqc/infer_experiment/*.infer_experiment.txt",
    "{star_salmon,star_rsem,hisat2}/qualimap/*/rnaseq_qc_results.txt",
    "{star_salmon,star_rsem,hisat2}/featurecounts/*.featureCounts.txt.summary",
    "{star_salmon,star_rsem,hisat2}/contaminants/kraken2/kraken_reports/*.kraken2.report.txt",
    "sortmerna/*.sortmerna.log",
    "trimgalore/*_trimming_report.txt",
    "{star_salmon,salmon,star_rsem,kallisto}/*.merged.tx2gene.tsv"
  ],

  "derived_metrics": [
    "cds_pct", "utr_pct", "intron_pct", "intergenic_pct",
    "exon_intron_ratio", "exon_intergenic_ratio", "sense_antisense_ratio",
    "genes_detected", "genes_detected_percent", "top30_count_percent",
    "unaligned_reads"
  ],

  "outputs": [
    { "glob": "{star_salmon,star_rsem,hisat2}/*.markdup.sorted.bam",
      "sample_type": "A.ALN", "cardinality": "per_sample", "primary_data": true,
      "secondary_data_glob": "{star_salmon,star_rsem,hisat2}/*.markdup.sorted.bam.bai",
      "attributes": { "Type": "BAM", "DataType": "bam",
                      "Aligner": "$params.aligner", "Genome": "$params.genome",
                      "Software": "$software_versions.STAR" } },

    { "glob": "{star_salmon,salmon,star_rsem,kallisto}/*.merged.gene_counts.tsv",
      "sample_type": "A.GEX", "cardinality": "per_run", "primary_data": true,
      "attributes": { "Matrix": "gene_counts", "MatrixDataType": "tsv",
                      "DataType": "gene-level raw counts" } }
  ],

  "provenance_attributes": {
    "Pipeline":             "$pipeline.name",
    "PipelineVersion":      "$pipeline.version",
    "Aligner":              "$params.aligner",
    "Pseudo_Aligner":       "$params.pseudo_aligner",
    "ReferenceGenome":      "$params.genome",
    "Link_ReferenceGenome": "$params.fasta",
    "AnnotationGTF":        "$params.gtf",
    "Link_GTF":             "$params.gtf",
    "Software":             "$software_versions",
    "Link_QualityControl":  "$outputs.multiqc_report_html",
    "DESeqFile":            "$outputs.deseq2_dds_rdata",
    "DESeqFile_Link":       "$outputs.deseq2_dds_rdata"
  },

  "qc_attributes": {
    "TotalReads":           { "from": "star-total_reads", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": ["samtools_stats-raw_total_sequences"],
                              "note": "reads entering alignment, i.e. post-trim. The raw pre-trim count is NOT on the sample row: fastqc_raw-total_sequences appears only on the per-read <sample>_1/_2 rows.",
                              "provenance": "seed" },
    "NumAligned":           { "from": "star-uniquely_mapped", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "MappedPercent":        { "from": "star-uniquely_mapped_percent", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": ["samtools_stats-reads_mapped_percent", "salmon-percent_mapped"],
                              "provenance": "seed" },
    "UnalignedReads":       { "from": "$derived.unaligned_reads", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "CDSPercent":           { "from": "$derived.cds_pct",
                              "target": "D.SEQ", "datatype": "number", "provenance": "seed" },
    "UTRPercent":           { "from": "$derived.utr_pct",
                              "target": "D.SEQ", "datatype": "number",
                              "note": "5'UTR + 3'UTR summed by the harvester",
                              "provenance": "seed" },
    "IntronPercent":        { "from": "$derived.intron_pct",
                              "target": "D.SEQ", "datatype": "number", "provenance": "seed" },
    "IntergenicPercent":    { "from": "$derived.intergenic_pct",
                              "target": "D.SEQ", "datatype": "number", "provenance": "seed" },
    "ExonIntronRatio":      { "from": "$derived.exon_intron_ratio", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "ExonIntergenicRatio":  { "from": "$derived.exon_intergenic_ratio", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "5_3UTR":               { "from": "qualimap_rnaseq-5_3_bias", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "SenseAntisenseRatio":  { "from": "$derived.sense_antisense_ratio", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "rRNAPercent":          { "from": "custom_content_biotype_counts-percent_rRNA", "target": "D.SEQ",
                              "datatype": "number",
                              "alternates": [],
                              "note": "from the featureCounts biotype table; sortmerna only runs under remove_ribo_rna",
                              "provenance": "seed" },
    "GenesDetected":        { "from": "$derived.genes_detected", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "GenesDetectedPercent": { "from": "$derived.genes_detected_percent", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "Top30CountPercent":    { "from": "$derived.top30_count_percent", "target": "D.SEQ",
                              "datatype": "number", "provenance": "seed" },
    "ContamPercent":        { "from": "kraken2-pct_unclassified", "target": "D.SEQ",
                              "datatype": "number",
                              "note": "only when contaminant screening ran",
                              "provenance": "seed" },
    "Link_Contamination":   { "from": "$outputs.kraken2_report", "target": "D.SEQ",
                              "datatype": "string", "provenance": "seed" },
    "Link_QC":              { "from": "$outputs.multiqc_report_html", "target": "D.SEQ",
                              "datatype": "string", "provenance": "seed" },
    "Genome":               { "from": "$params.genome", "target": "D.SEQ",
                              "datatype": "string", "provenance": "seed" }
  },

  "deliberately_unmapped": [
    { "key": "strandedness_inferred",
      "why": "D.SEQ has no strandedness attribute. LibraryDesign is the plausible target but that is a schema decision, not a mapping one." },
    { "key": "ReadLanePct",
      "why": "Meaningful only for multi-run samples; nf-core concatenates before QC, so per-lane percentages are not recoverable." },
    { "key": "20mers", "why": "No nf-core/rnaseq equivalent." },
    { "key": "MaxReads", "why": "A sequencer capacity figure, not a pipeline output." },
    { "key": "Picard_PERCENT_DUPLICATION",
      "why": "No D.SEQ duplication attribute exists. Worth proposing as a schema addition; until then it goes to the queue, not silently dropped." }
  ]
}
