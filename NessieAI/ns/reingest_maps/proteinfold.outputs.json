{
  "map_version": 2,
  "pipeline": "nf-core/proteinfold",
  "applies_to_versions": ">=2.0.0,<2.1",
  "accepts_parent_types": [
    "D.PSEQ"
  ],
  "samplesheet_sample_column": "id",
  "harvest_globs": [],
  "inventory_globs": [
    "**/top_ranked_structures/*.pdb",
    "**/top_ranked_structures/*.cif",
    "**/*_plddt.tsv",
    "**/*_ptm.tsv",
    "**/*_iptm.tsv"
  ],
  "derived_metrics": [],
  "row_defaults": {
    "Name": "@row_name",
    "Scientist": "@nextseek_user",
    "Lab": "@lab",
    "SampleCreationDate": "@run_date"
  },
  "outputs": [
    {
      "id": "esmfold",
      "candidates": [
        "esmfold/top_ranked_structures/*.pdb"
      ],
      "sample_type": "A.PSTR",
      "assay": "Protein Structure Prediction",
      "cardinality": "per_sample",
      "primary_data": true,
      "optional": true,
      "skip_samples_without_file": true,
      "include_provenance": true,
      "companions": [
        {
          "glob": "esmfold/*/*_plddt.tsv",
          "slot": "File_SecondaryData"
        },
        {
          "glob": "esmfold/*/*_ptm.tsv"
        },
        {
          "glob": "esmfold/*/*_iptm.tsv"
        }
      ],
      "attributes": {
        "DataType": "PDB",
        "Software": "ESMFold",
        "PredictionMethod": "ESMFold",
        "ModelRank": "1",
        "Notes": "ESMFold top-ranked model (upstream's rank_0) from nf-core/proteinfold --mode esmfold; per-residue pLDDT in the secondary file. A computational model, not an experimental structure."
      }
    },
    {
