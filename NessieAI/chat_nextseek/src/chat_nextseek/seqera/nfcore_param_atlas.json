            }
          },
          "corroborate_with": [
            {
              "signal": "Protocol",
              "R64-1-1_markers": [
                "yeast spike-in",
                "yeast dna spike-in",
                "s. cerevisiae spike-in"
              ],
              "BDGP6_markers": [
                "drosophila spike-in",
                "fly spike-in",
                "drosophila dna spike-in"
              ]
            },
            {
              "signal": "Notes",
              "R64-1-1_markers": [
                "yeast spike-in",
