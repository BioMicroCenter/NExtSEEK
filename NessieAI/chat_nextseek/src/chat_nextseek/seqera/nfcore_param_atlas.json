{
  "guidance": {
    "notes": [
      "A data-driven param is set from the cohort's own metadata, never a static default. Derive it, corroborate it against independent evidence in the SAME record, and STOP to ask when they conflict or the evidence is absent. A wrong value here does not error, it produces a confident wrong result.",
      "seq_type corroboration is on the DNA/RNA axis, which is orthogonal to the TCR-vs-GEX labelling that was wrong in study 241114SHA (both TCR and GEX are RNA). The check is not there to re-catch that bug; it is there for a sample whose SequencingType says RNA but whose filename says WES."
    ]
  },
  "pipelines": {
    "hlatyping": {
      "params": {
        "seq_type": {
          "target": "row_column",
          "scope": "sample",
          "allowed": ["dna", "rna"],
          "derive_from": {
            "signal": "SequencingType",
            "map": {
              "rna": ["RNA", "TCR", "GEX", "TRANSCRIPTOM", "scRNA"],
              "dna": ["WES", "WGS", "EXOME", "GENOMIC"]
            }
          },
          "corroborate_with": [
            {"signal": "Name",             "rna_markers": ["GEX", "TCR", "RNA", "cDNA"], "dna_markers": ["WES", "WGS", "EXOME"]},
            {"signal": "File_PrimaryData", "rna_markers": ["GEX", "TCR", "RNA", "cDNA"], "dna_markers": ["WES", "WGS", "EXOME"]},
            {"signal": "LibrarySource",    "rna_markers": ["TRANSCRIPTOMIC"],            "dna_markers": ["GENOMIC"]},
            {"signal": "LibraryStrategy",  "rna_markers": ["RNA-Seq", "ncRNA-Seq", "miRNA-Seq"], "dna_markers": ["WGS", "WXS", "WES"]}
          ],
          "ask": {
            "definition": "Whether each library is DNA (WES/WGS) or RNA; it changes OptiType's configuration.",
            "on_conflict": "The sequencing-type label and the sample's own name/files disagree about DNA vs RNA. I won't guess, which is right?",
            "on_absent": "Nothing in these samples' metadata says whether they are DNA or RNA libraries. Which are they?"
          }
        }
      }
    },
    "rnaseq": {
      "params": {
        "extra_salmon_quant_args": {
          "target": "run_param",
          "scope": "sample",
          "allowed": ["--noLengthCorrection", ""],
          "on_absent": "use_default",
          "default": "",
          "derive_from": {
            "signal": "__protocol_text__",
            "map": {
              "--noLengthCorrection": [
                "quantseq", "quant-seq", "lexogen",
                "brb-seq", "brbseq", "mars-seq", "marsseq", "tag-seq", "tagseq",
                "3' dge", "3'dge", "3’ dge", "3’dge",
                "digital gene expression",
                "3' rna-seq", "3' rna seq", "3’ rna-seq", "3’ rna seq",
                "3' mrna-seq", "3' mrna seq", "3’ mrna-seq", "3’ mrna seq"
              ]
            }
          },
          "corroborate_with": [
            {
              "signal": "ExpressionKit",
              "--noLengthCorrection_markers": ["quantseq", "quant-seq", "lexogen", "brb-seq", "mars-seq"]
            },
            {
              "signal": "LibrarySelection",
              "--noLengthCorrection_markers": ["3' dge", "3’ dge", "quantseq", "tag-seq", "digital gene expression"]
            },
            {
              "signal": "Name",
              "--noLengthCorrection_markers": ["quantseq", "3pdge", "3dge", "tagseq"]
            }
          ],
          "ask": {
            "definition": "Whether salmon should skip transcript-length correction. A 3' DGE / tag-counting library (QuantSeq, BRB-seq, MARS-seq) sequences only the 3' end, so a transcript's length says nothing about how many reads it should get, and correcting for it biases every fold change. A standard full-length library needs the correction.",
            "on_conflict": "The prep protocol and the kit/library fields disagree about whether this is a 3' tag-counting library or a standard full-length RNA library. Which was prepped?",
            "on_absent": "not used — rnaseq assumes a standard full-length library and applies length correction"
          }
        }
      }
    },
    "scrnaseq": {
      "params": {
        "protocol": {
          "target": "run_param",
          "scope": "sample",
          "allowed": ["auto", "10XV2", "10XV3", "10XV4", "dropseq"],
          "on_absent": "ask",
          "derive_from": {
            "signal": "ExpressionKit",
            "map": {
              "10XV2": ["10xv2", "10x v2", "chromium v2", "3' v2", "single cell 3' v2"],
              "10XV3": ["10xv3", "10x v3", "chromium v3", "3' v3", "single cell 3' v3", "next gem"],
              "10XV4": ["10xv4", "10x v4", "gem-x"],
              "dropseq": ["drop-seq", "dropseq", "seq-well", "seqwell"]
            }
          },
          "corroborate_with": [
            {"signal": "LibrarySelection",  "10XV2_markers": ["10x v2"], "10XV3_markers": ["10x v3"], "dropseq_markers": ["drop-seq", "seq-well"]},
            {"signal": "Name",              "10XV2_markers": ["10xv2", "v2"], "10XV3_markers": ["10xv3", "v3"], "dropseq_markers": ["dropseq", "seqwell"]},
            {"signal": "__protocol_text__", "10XV2_markers": ["chromium single cell 3' v2", "10x v2"], "10XV3_markers": ["chromium single cell 3' v3", "10x v3", "next gem"], "10XV4_markers": ["gem-x", "10x v4"], "dropseq_markers": ["drop-seq", "seq-well"]}
          ],
          "ask": {
            "definition": "Single-cell chemistry (10x v2/v3/v4 or Drop-seq/Seq-Well). It changes how the aligner parses cell barcodes and UMIs.",
            "on_conflict": "The kit fields, the sample name, and the protocol document disagree about the single-cell chemistry. Which was used?",
            "on_absent": "I can't tell which single-cell chemistry was used (the exact version isn't recorded). Which chemistry: 10x v2, 10x v3, 10x v4, or Drop-seq?"
          }
        }
      }
    },
    "smrnaseq": {
      "params": {
        "three_prime_adapter": {
          "target": "run_param",
          "scope": "sample",
          "allowed": ["AGATCGGAAGAGCACACGTCTGAACTCCAGTCA", "AACTGTAGGCACCATCAAT"],
          "on_absent": "use_default",
          "default": "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA",
          "derive_from": {
            "signal": "ExpressionKit",
            "map": {
              "AACTGTAGGCACCATCAAT": ["qiaseq", "qia-seq"]
            }
          },
          "corroborate_with": [
            {"signal": "ReagentManufacturer", "AACTGTAGGCACCATCAAT_markers": ["qiaseq", "qiagen mirna"]},
            {"signal": "__protocol_text__",   "AACTGTAGGCACCATCAAT_markers": ["qiaseq mirna"]}
          ],
          "ask": {
            "definition": "The 3' adapter to trim off small-RNA reads. Determined by the library prep kit.",
            "on_conflict": "The kit fields and the protocol document disagree about the small-RNA kit / 3' adapter. Which kit was used?",
            "on_absent": "not used — smrnaseq falls back to the Illumina adapter"
          }
        }
      }
    },
    "sarek": {"params": {
      "status": {
        "target": "row_column", "scope": "sample", "allowed": ["0", "1"],
        "on_absent": "use_default", "default": "0", "confirm_in": "pairing_table",
        "ambiguous_markers": ["non-tumor", "non-tumour", "nontumor", "nontumour", "non-malignant", "nonmalignant", "non-cancer", "noncancer", "abnormal", "adjacent",
          "non-neoplastic", "nonneoplastic", "tumor-free", "tumour-free", "tumor free", "tumour free", "non tumor", "non tumour"],
        "derive_from": {"signal": "Type", "map": {
          "1": ["tumor", "tumour", "cancer", "carcinoma", "malignan", "metasta", "neoplas"],
          "0": ["normal", "healthy", "germline", "blood", "pbmc", "buffy"]}},
        "corroborate_with": [
          {"signal": "Name", "1_markers": ["tumor", "tumour"], "0_markers": ["normal", "germline", "blood"]}],
        "ask": {
          "definition": "Whether each sample is tumour (1) or normal (0); sarek pairs a patient's tumour with its normal for somatic calling.",
          "on_conflict": "The sample's metadata reads both ways about tumour vs normal: a field says something like \"non-tumour\" or \"adjacent\", or its tissue type and its own name disagree. I won't guess, which is right?",
          "on_absent": "Nothing in these samples' metadata says tumour or normal. Which are tumour?"}
      },
      "intervals": {
        "target": "run_param", "scope": "run", "detect_only": true,
        "detect": {"signal": "LibraryStrategy", "markers": ["WXS", "WES", "exome", "Targeted-Capture", "capture", "panel"]},
        "corroborate_with": [{"signal": "SequencingType", "markers": ["WES", "exome", "capture", "panel"]}],
        "ask": {
          "definition": "The capture kit's target-region BED, as a path on the cluster. sarek calls variants only inside it; set wes=true with it.",
          "on_detect": "These look like exome or targeted-capture libraries. Which BED file of the kit's target regions should sarek use? Give its path on the cluster."}
      }
    }},
    "rnafusion": {
      "params": {
        "strandedness": {
          "target": "row_column",
          "scope": "sample",
          "allowed": [
            "forward",
            "reverse",
            "unstranded",
            "unknown"
          ],
          "derive_from": {
            "signal": "Strandedness",
            "map": {
              "forward": [
                "forward"
              ],
              "reverse": [
                "reverse"
              ],
              "unstranded": [
                "unstranded"
              ]
            }
          },
          "ask": {
            "definition": "Each library's strand-specificity, a required samplesheet column. NExtSEEK knows it when an earlier rnaseq run measured it (the D.SEQ Strandedness field), or from a kit whose strand is fixed (dUTP kits such as TruSeq Stranded or NEBNext Ultra II Directional are reverse).",
            "on_conflict": "This sample's measured strandedness and its library kit disagree. Which is it: forward, reverse or unstranded?",
            "on_absent": "No earlier run measured these libraries' strandedness and their kit does not fix it. Which is it: forward, reverse, unstranded, or unknown if you cannot tell?"
          },
          "corroborate_with": [
            {
              "signal": "ExpressionKit",
              "reverse_markers": [
                "truseq stranded",
                "illumina stranded",
                "nebnext ultra ii directional",
                "nebnext ultra directional",
                "kapa stranded",
                "dutp"
              ],
              "forward_markers": [
                "quantseq fwd"
              ],
              "unstranded_markers": [
                "truseq rna library prep",
                "smart-seq"
              ]
            },
            {
              "signal": "Protocol",
              "reverse_markers": [
                "truseq stranded",
                "illumina stranded",
                "nebnext ultra ii directional",
                "nebnext ultra directional",
                "kapa stranded",
                "dutp"
              ],
              "forward_markers": [
                "quantseq fwd"
              ],
              "unstranded_markers": [
                "truseq rna library prep",
                "smart-seq"
              ]
            }
          ]
        }
      }
    },
    "rnasplice": {
      "params": {
        "strandedness": {
          "target": "row_column",
          "scope": "sample",
          "allowed": [
            "forward",
            "reverse",
            "unstranded"
          ],
          "derive_from": {
            "signal": "Strandedness",
            "map": {
              "forward": [
                "forward"
              ],
              "reverse": [
                "reverse"
              ],
              "unstranded": [
                "unstranded"
              ]
            }
          },
          "ask": {
            "definition": "Each library's strand-specificity, a required samplesheet column. rnasplice 2.0.0 accepts only forward, reverse or unstranded (no auto), and rMATS needs every sample to share one. NExtSEEK knows it when an earlier rnaseq run measured it (the D.SEQ Strandedness field), or from a kit whose strand is fixed (dUTP kits such as TruSeq Stranded or NEBNext Ultra II Directional are reverse).",
            "on_conflict": "This sample's measured strandedness and its library kit disagree. Which is it: forward, reverse or unstranded?",
            "on_absent": "No earlier run measured these libraries' strandedness, their kit does not fix it, and rnasplice cannot infer it. Which is it: forward, reverse or unstranded?"
          },
          "corroborate_with": [
            {
              "signal": "ExpressionKit",
              "reverse_markers": [
                "truseq stranded",
                "illumina stranded",
                "nebnext ultra ii directional",
                "nebnext ultra directional",
                "kapa stranded",
                "dutp"
              ],
              "forward_markers": [
                "quantseq fwd"
              ],
              "unstranded_markers": [
                "truseq rna library prep",
                "smart-seq"
              ]
            },
            {
              "signal": "Protocol",
              "reverse_markers": [
                "truseq stranded",
                "illumina stranded",
                "nebnext ultra ii directional",
                "nebnext ultra directional",
                "kapa stranded",
                "dutp"
              ],
              "forward_markers": [
                "quantseq fwd"
              ],
              "unstranded_markers": [
                "truseq rna library prep",
                "smart-seq"
              ]
            }
          ]
        }
      }
    },
    "riboseq": {
      "params": {
        "type": {
          "target": "row_column",
          "scope": "sample",
          "allowed": [
            "riboseq",
            "tiseq",
            "rnaseq"
          ],
          "derive_from": {
            "signal": "SequencingType",
            "map": {
              "riboseq": [
                "ribo-seq",
                "riboseq",
                "ribosome profiling",
                "footprint"
              ],
              "tiseq": [
                "ti-seq",
                "tiseq",
                "translation initiation"
              ],
              "rnaseq": [
                "rna-seq",
                "rnaseq",
                "mrna-seq"
              ]
            }
          },
          "corroborate_with": [
            {
              "signal": "LibraryType",
              "riboseq_markers": [
                "ribo-seq",
                "riboseq",
                "ribosome profiling"
              ],
              "tiseq_markers": [
                "ti-seq",
                "tiseq"
              ],
              "rnaseq_markers": [
                "rna-seq",
                "rnaseq",
                "mrna-seq"
              ]
            },
            {
              "signal": "Protocol",
              "riboseq_markers": [
                "footprint",
                "ribosome profiling",
                "ribosome-protected"
              ],
              "tiseq_markers": [
                "harringtonine",
                "lactimidomycin",
                "translation initiation"
              ]
            },
            {
              "signal": "LibraryStrategy",
              "riboseq_markers": [
                "Ribo-Seq"
              ]
            },
            {
              "signal": "Name",
              "riboseq_markers": [
                "riboseq",
                "ribo-seq",
                "footprint"
              ],
              "tiseq_markers": [
                "tiseq",
                "ti-seq"
              ],
              "rnaseq_markers": [
                "rnaseq",
                "rna-seq"
              ]
            }
          ],
          "ask": {
            "definition": "Whether each library is ribosome footprints (riboseq), translation-initiation footprints (tiseq) or ordinary RNA-seq of the same samples (rnaseq). It decides which libraries the footprint analyses read and which pair with them for translational efficiency.",
            "on_conflict": "This library's sequencing type, library type, protocol and name disagree about whether it is Ribo-seq footprints, TI-seq or ordinary RNA-seq. Which is it?",
            "on_absent": "Nothing in this library's metadata says whether it is Ribo-seq footprints, TI-seq or ordinary RNA-seq. Which is it?"
          }
        },
        "strandedness": {
          "target": "row_column",
          "scope": "sample",
          "allowed": [
            "forward",
            "reverse",
            "unstranded",
            "auto"
          ],
          "on_absent": "use_default",
          "default": "auto",
          "derive_from": {
            "signal": "Strandedness",
            "map": {
              "forward": [
                "forward"
              ],
              "reverse": [
                "reverse"
              ],
              "unstranded": [
                "unstranded"
              ]
            }
          },
          "ask": {
            "definition": "Each library's strand-specificity, a required samplesheet column. auto has riboseq infer it with Salmon from a million reads.",
            "on_conflict": "This sample's recorded strandedness reads more than one way. Which is it: forward, reverse or unstranded?",
            "on_absent": "not used: with no measured strandedness riboseq infers it (auto)"
          }
        }
      }
    },
    "rnavar": {
      "params": {
        "read_length": {
          "target": "run_param",
          "scope": "run",
          "value_type": "integer",
          "on_absent": "use_default",
          "default": "150",
          "range": [
            20,
            1000
          ],
          "derive_from": {
            "signal": "F_bp",
            "number": "exact"
          },
          "corroborate_with": [
            {
              "signal": "R_bp",
              "number": "exact"
            }
          ],
          "ask": {
            "definition": "The reads' length; STAR builds its index with read_length - 1 as the splice-junction overhang, so it must match the reads (2x151 reads: 151).",
            "on_conflict": "The forward and reverse read lengths recorded for these libraries differ, or differ between libraries. Which read length should STAR's index use?",
            "on_absent": "not used: with no recorded read length rnavar keeps its default of 150"
          }
        }
      }
    },
    "atacseq": {
      "params": {
        "read_length": {
          "target": "run_param",
          "scope": "run",
          "value_type": "integer",
          "allowed": [
            "50",
            "75",
            "100",
            "150",
            "200"
          ],
          "derive_from": {
            "signal": "F_bp",
            "number": "floor"
          },
          "corroborate_with": [
            {
              "signal": "R_bp",
              "number": "floor"
            }
          ],
          "ask": {
            "definition": "The read length atacseq uses to look up the effective genome size for peak calling; the schema takes only 50, 75, 100, 150 or 200, so reads are rounded down (2x151 reads: 150).",
            "on_conflict": "The forward and reverse read lengths recorded for these libraries differ, or differ between libraries. Which read length (50, 75, 100, 150 or 200) should peak calling use?",
            "on_absent": "No read length is recorded for these libraries, and peak calling needs one to look up the genome size. Which is closest without going over: 50, 75, 100, 150 or 200?"
          }
        }
      }
    },
    "chipseq": {
      "params": {
        "read_length": {
          "target": "run_param",
          "scope": "run",
          "value_type": "integer",
          "allowed": [
            "50",
            "75",
            "100",
            "150",
            "200"
          ],
          "derive_from": {
            "signal": "F_bp",
            "number": "floor"
          },
          "corroborate_with": [
            {
              "signal": "R_bp",
              "number": "floor"
            }
          ],
          "ask": {
            "definition": "The read length chipseq uses to look up the effective genome size for peak calling; the schema takes only 50, 75, 100, 150 or 200, so reads are rounded down (2x151 reads: 150).",
            "on_conflict": "The forward and reverse read lengths recorded for these libraries differ, or differ between libraries. Which read length (50, 75, 100, 150 or 200) should peak calling use?",
            "on_absent": "No read length is recorded for these libraries, and peak calling needs one to look up the genome size. Which is closest without going over: 50, 75, 100, 150 or 200?"
          }
        },
        "narrow_peak": {
          "target": "run_param",
          "scope": "run",
          "value_type": "boolean",
          "abstain_when": {
            "signal": "Name",
            "markers": [
              "input",
              "igg"
            ]
          },
          "allowed": [
            "true",
            "false"
          ],
          "derive_from": {
            "signal": "Name",
            "map": {
              "false": [
                "H3K",
                "H4K",
                "H2AK",
                "H2BK",
                "histone"
              ]
            }
          },
          "corroborate_with": [
            {
              "signal": "Protocol",
              "false_markers": [
                "H3K",
                "H4K",
                "H2AK",
                "H2BK",
                "histone"
              ]
            },
            {
              "signal": "Notes",
              "false_markers": [
                "H3K",
                "H4K",
                "H2AK",
                "H2BK",
                "histone"
              ]
            },
            {
              "signal": "AntibodyParent",
              "false_markers": [
                "H3K",
                "H4K",
                "H2AK",
                "H2BK",
                "histone"
              ]
            }
          ],
          "ask": {
            "definition": "Whether MACS3 calls narrow peaks (a transcription factor's sharp sites) or its default broad peaks (a histone mark's domains).",
            "on_conflict": "These libraries' names, protocols and notes read both ways about whether the target is a histone mark. Is it a histone mark (broad peaks) or a transcription factor (narrow peaks)?",
            "on_absent": "Nothing in these libraries' names, protocols or notes names a histone mark. Is the antibody's target a transcription factor (narrow peaks) or a histone mark (broad peaks)? If the cohort holds both, they are best run separately."
          }
        }
      }
    },
    "cutandrun": {
