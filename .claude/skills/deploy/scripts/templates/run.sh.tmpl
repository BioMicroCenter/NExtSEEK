#!/bin/bash
# deploy launch runner @@TAG@@ for @@INSTANCE@@. Rendered by launch.py from the validated brief;
# do not edit it by hand (re-render instead). Sequential; every step appends one line to $ST that
# ends in a UTC HH:MM:SS, and the last line is ALL_DONE. It never rolls anything back.
set -u
cd @@REPO@@ || exit 1
H=@@HOME@@
TAG=@@TAG@@
EXP=@@EXP@@
INSTANCE=@@INSTANCE@@
IN=@@IN@@
COMPONENTS="@@COMPONENTS@@"
RECREATE_NGINX_ON="@@RECREATE_NGINX_ON@@"
CONTINUE_ON_FAILURE=" @@CONTINUE_ON_FAILURE@@ "
DO_STATIC=@@DO_STATIC@@ DO_LABS=@@DO_LABS@@ DO_CI=@@DO_CI@@ DO_NESSIE=@@DO_NESSIE@@
CI_FLAGS="@@CI_FLAGS@@"
SEEK_RESTART_OK=@@SEEK_RESTART_OK@@ SEEK_RESTART_GIB=@@SEEK_RESTART_GIB@@
CASES="@@CASES@@"
NESSIE_FLAGS="@@NESSIE_FLAGS@@"
KNOWN_CI_REDS='@@KNOWN_CI_REDS@@'
KNOWN_HEALTH_REDS='@@KNOWN_HEALTH_REDS@@'
SUMMARY_RED='@@SUMMARY_RED@@'
WINDOWS="@@WINDOWS@@"
DISCARD="@@DISCARD@@"
SET_ASIDE="@@SET_ASIDE@@"
REHEARSE=@@REHEARSE@@   # 1 when the range has a migration (the brief's migrations_expected or the commits step's migration flag)

ST=$H/launch-$TAG.status; L=$H/launch-$TAG
# >>> functions (tests/test_launch.py sources this block)
say(){ echo "$* $(date -u +%H:%M:%S)" >> "$ST"; }
stop(){ say "STOPPED: $*"; say ALL_DONE; exit 1; }
logname(){ case "$1" in
@@LOGNAME_CASES@@
esac; }
success_line(){ case "$1" in
@@SUCCESS_CASES@@
esac; }
need_of(){ case "$1" in
@@HEALTH_CASES@@
  *) echo "";; esac; }
in_window(){ # the stop window the current UTC time falls in, if any (HHMM-HHMM)
  now=$(date -u +%H%M)
  for w in $WINDOWS; do
    s=${w%-*}; e=${w#*-}
    if [ "$s" -lt "$e" ]; then
      [ "$now" -ge "$s" ] && [ "$now" -lt "$e" ] && echo "$w"
    else
      { [ "$now" -ge "$s" ] || [ "$now" -lt "$e" ]; } && echo "$w"
    fi
  done
  return 0
}
health_reds(){ # $1 log: every ✗ line, its wrapped continuation and detail lines joined, the mark stripped
  awk '
    /^[[:space:]]+✗ / { if (r != "") print r; r = $0; sub(/^[[:space:]]+✗ /, "", r); next }
    r != "" && /^[^[:space:]]/ && !/^(╭|│|╰|FAILED|ERROR|XFAIL|XPASS|PASSED|=)/ { r = r $0; next }
    r != "" && /^         [[:space:]]*[^[:space:]]/ { d = $0; sub(/^[[:space:]]+/, "", d); r = r " " d; next }
    { if (r != "") print r; r = "" }
    END { if (r != "") print r }' "$1" | sed -E 's/[[:space:]]+$//'
}
classify(){ # $1 one red: skip | known | summary | pending <component> | stale <component> | unexplained
  case "$1" in "CI failed"*|"CI passed"*|"stopped before building"*) echo skip; return;; esac
  if printf '%s\n' "$1" | grep -qE "$KNOWN_HEALTH_REDS"; then echo known; return; fi
  if printf '%s\n' "$1" | grep -qE "$SUMMARY_RED"; then echo summary; return; fi
  n=$(need_of "$1")
  if [ -n "$n" ]; then
    case " $PENDING " in *" $n "*) echo "pending $n";; *) echo "stale $n";; esac
    return
  fi
  echo unexplained
}
judge(){ # $1 log $2 label: records every red with its class; prints the reds nothing explains, then
  # the rebuild's summary line, beside one of them or when no known or pending red explains it (launch.py bad_reds)
  health_reds "$1" | { bad=""; sum=""; why=""
    while IFS= read -r line; do
      c=$(classify "$line")
      [ "$c" = skip ] && continue
      say "RED $2 [$c] $(echo "$line" | cut -c1-160)"
      case "$c" in known|pending*) why=1;; summary) sum="$line";; *) bad=1; echo "$line";; esac
    done
    if [ -n "$sum" ] && { [ -n "$bad" ] || [ -z "$why" ]; }; then echo "$sum"; fi; }
}
rollback_tag(){ # $1 log: the verified tag, even when the rebuild's output wrapped it onto the next line
  tr -s ' \n' ' ' < "$1" | grep -m1 -o "rollback tag verified: [^ ]*"
}
rebuild(){ # $1 component; returns 1 when its success line is missing
  extra=""; [ "$1" = "$RECREATE_NGINX_ON" ] && { extra="--recreate-nginx"; say "NGINX_RECREATE with the $1 rebuild (docker/nginx.conf changed, 'nginx recreate ok')"; }
  ./startup.sh rebuild --component "$1" --no-ci $extra > "$L/$(logname "$1").log" 2>&1 </dev/null
  say "REBUILD $1 exit=$?"
  t=$(rollback_tag "$L/$(logname "$1").log")
  [ -n "$t" ] && say "ROLLBACK $1 ${t#rollback tag verified: }"
  PENDING=$(echo " $PENDING " | sed "s/ $1 / /; s/^ *//; s/ *\$//")
  grep -qF "$(success_line "$1")" "$L/$(logname "$1").log"
}
marker(){ # $1 container $2 file $3 fixed string
  n=$(docker exec "$1" grep -cF -- "$3" "$2" 2>/dev/null </dev/null)
  echo "MARKER count=${n:-0} container=$1 file=$2 pattern=$3"
}
set_aside(){ # local edits to files the range CHANGES: copy them to $H/backups/seed-dirty-$TAG (0600), then reset them
  for p in $SET_ASIDE; do
    [ -n "$(git status --short -- "$p")" ] || continue
    git diff --quiet HEAD "$EXP" -- "$p" && continue   # the range leaves this file alone: keep the local edit
    d=$H/backups/seed-dirty-$TAG
    { mkdir -p "$d" && chmod 700 "$d" && cp -p "$p" "$d/" && chmod 600 "$d/$(basename "$p")" \
      && cmp -s "$p" "$d/$(basename "$p")" && git checkout -- "$p"; } || return 1
    say "SET_ASIDE $p -> $d"
  done
}
rehearse(){ # the migration rehearsal, run AFTER the new app image is built and BEFORE anything restarts: this box's
  # schema (no rows, plus django_migrations and django_content_type) is loaded into a throwaway MySQL and the NEW image
  # runs `migrate` against it. Reads the live DB only (mysqldump --single-transaction --no-data, two tables' rows).
  # Returns 1 on any failure; the error tail is in $L/rehearsal.log. Its own subshell, so the EXIT trap always cleans.
  ( set +x; umask 077
    net=rehearse-net-$TAG; ctr=rehearse-db-$TAG; mig=rehearse-mig-$TAG; dump=$H/backups/rehearse-$TAG.sql.gz; log=$L/rehearsal.log
    : > "$log"; t0=$(date +%s)
    # a runner killed mid-rehearsal (SIGKILL skips the trap) leaves its 2 GB db and its network: remove every leftover first
    for o in $(docker ps -a --format '{{.Names}}' --filter name=rehearse- </dev/null 2>/dev/null | grep -E '^rehearse-(db|mig)-'); do docker rm -f "$o" >/dev/null 2>&1; done
    for o in $(docker network ls --format '{{.Name}}' --filter name=rehearse-net- </dev/null 2>/dev/null | grep '^rehearse-net-'); do docker network rm "$o" >/dev/null 2>&1; done
    rm -f "$H"/backups/rehearse-*.sql.gz*
    cleanup(){ rc=$?   # on a failure the throwaway db's own last lines go under a marker, after the error
      [ $rc = 0 ] || { echo "--- the throwaway db, last 20 lines"; docker logs --tail 20 "$ctr" </dev/null 2>&1; } >> "$log"
      docker rm -f "$ctr" "$mig" >/dev/null 2>&1; docker network rm "$net" >/dev/null 2>&1; rm -f "$dump" "$dump.body"; }
    trap cleanup EXIT
    # the throwaway runs the live db container's own image and command (its flags: charset, collation); never without them
    dbc=$(docker compose ps -q db </dev/null 2>/dev/null | head -1)
    [ -n "$dbc" ] || { echo "no running db container: the throwaway db never starts without the live one's flags" >> "$log"; exit 1; }
    img=$(docker inspect -f '{{.Image}}' "$dbc" </dev/null 2>/dev/null)
    mapfile -t margs < <(docker inspect -f '{{range .Config.Cmd}}{{println .}}{{end}}' "$dbc" </dev/null 2>/dev/null | sed '/^$/d')
    { [ -n "$img" ] && [ ${#margs[@]} -gt 0 ]; } || { echo "could not read the db container's image and command" >> "$log"; exit 1; }
    dbn=$(docker exec nextseek printenv NEXTSEEK_MYSQL_DATABASE </dev/null 2>/dev/null); dbn=${dbn:-dmac}
    # the live db's password stays inside its own container (MYSQL_PWD from its env); nothing secret is on an argv.
    # Line 1 out = the live database's default charset and collation (the throwaway's CREATE DATABASE reuses them),
    # then ---, then the schema without rows, then the rows of the two tables migrate reads. sh -e: a failed step stops
    docker compose exec -T -e DBN="$dbn" db sh -ec 'export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"
      mysql -h127.0.0.1 -uroot -N -e "select concat(default_character_set_name, \" \", default_collation_name) from information_schema.schemata where schema_name=\"$DBN\""
      echo ---
      mysqldump -h127.0.0.1 -uroot --single-transaction --no-data --skip-triggers "$DBN"
      mysqldump -h127.0.0.1 -uroot --single-transaction --no-create-info --skip-triggers "$DBN" django_migrations django_content_type' \
      </dev/null 2>>"$log" | gzip -c > "$dump"
    [ "${PIPESTATUS[0]}" = 0 ] || { echo "schema dump failed" >> "$log"; exit 1; }
    cs=$(zcat "$dump" | sed -n '1p'); zcat "$dump" | sed '1,/^---$/d' | gzip -c > "$dump.body" && mv -f "$dump.body" "$dump"
    export REHEARSE_PW=$(head -c 18 /dev/urandom | base64 | tr -d '/+=\n')   # a throwaway password for a throwaway container
    docker network create --internal "$net" >/dev/null 2>&1 || { echo "network create failed" >> "$log"; exit 1; }
    # timeout (coreutils, in the mysql image) as the container's entrypoint is the real limit: it holds with no runner left
    docker run -d --name "$ctr" --network "$net" --memory 2g -e MYSQL_ROOT_PASSWORD="$REHEARSE_PW" \
      --entrypoint timeout "$img" -k 10 900 docker-entrypoint.sh "${margs[@]}" >/dev/null 2>>"$log" \
      || { echo "throwaway db did not start" >> "$log"; exit 1; }
    ok=0; for i in $(seq 60); do
      docker exec -e MYSQL_PWD="$REHEARSE_PW" "$ctr" mysqladmin ping -h127.0.0.1 -uroot --silent </dev/null >/dev/null 2>&1 && { ok=1; break; }; sleep 2; done
    [ $ok = 1 ] || { echo "throwaway db never answered" >> "$log"; exit 1; }
    set -- $cs; cset=${1:-utf8mb4}; coll=${2:-utf8mb4_unicode_ci}
    { echo "create database \`$dbn\` default character set $cset collate $coll;"; echo "use \`$dbn\`;"; zcat "$dump"; } \
      | docker exec -i -e MYSQL_PWD="$REHEARSE_PW" "$ctr" mysql -h127.0.0.1 -uroot >> "$log" 2>&1 \
      || { echo "schema load failed" >> "$log"; exit 1; }
    # the settings go in on stdin and are written inside the container: no host mount, so no file mode, owner or SELinux
    # label matters (the app image may run as 10001)
    timeout -k 10 600 docker run -i --rm --name "$mig" --network "$net" --memory 2g -e REHEARSE_PW -e REHEARSE_DB="$dbn" \
      -e REHEARSE_HOST="$ctr" -e DJANGO_SETTINGS_MODULE=rehearsal_settings -e PYTHONPATH=/tmp/rehearsal -e LOG_DIR=/tmp/l \
      -e DJANGO_CSRF_TRUSTED_ORIGINS=https://rehearsal.invalid -w /app nextseek-nextseek:latest \
      sh -ec 'mkdir -p /tmp/rehearsal; cat > /tmp/rehearsal/rehearsal_settings.py; exec /app/.venv/bin/python manage.py migrate --noinput' \
      >> "$log" 2>&1 <<'PYEOF' || exit 1
import os
from dmac.test_settings import *  # noqa
DATABASES["default"] = {"ENGINE": "django.db.backends.mysql", "NAME": os.environ["REHEARSE_DB"], "USER": "root",
                        "PASSWORD": os.environ["REHEARSE_PW"], "HOST": os.environ["REHEARSE_HOST"], "PORT": "3306",
                        "OPTIONS": {"charset": "utf8mb4"}}
PYEOF
    names=$(grep -oE 'Applying [A-Za-z0-9_]+\.[A-Za-z0-9_]+' "$log" | sed 's/^Applying //' | paste -sd' ' -)   # app.migration only: DEBUG lines follow on the same line
    echo "REHEARSAL-OK applied=${names:-none} seconds=$(( $(date +%s) - t0 ))" >> "$log" )
}
build_and_rehearse(){ # REHEARSE=1, before ANY component is rebuilt: build the new app image WITHOUT restarting, then
  # rehearse its migrations. Judged by the success line, not the exit code: a --no-restart rebuild still runs stack
  # health and exits 1 on any red, and `app image code` is STALE until the restart. Returns 1 only for a failed build
  # of an app in continue_on_failure (the caller then skips the app: its restart would migrate the live database)
  ./startup.sh rebuild --component app --no-ci --no-restart > "$L/app-build.log" 2>&1 </dev/null
  say "APP_BUILD exit=$? (no restart)"
  t=$(rollback_tag "$L/app-build.log"); [ -n "$t" ] && say "ROLLBACK app ${t#rollback tag verified: } (the old image, tagged before the build; a component's first ROLLBACK line is its rollback point)"
  if ! grep -qF 'app image rebuilt; runtime restart deferred by request' "$L/app-build.log"; then
    case "$CONTINUE_ON_FAILURE" in
      *" app "*) say "FAILED app, continuing (continue_on_failure): the build failed before the migration rehearsal, the app is skipped, nothing was restarted, see $L/app-build.log"; return 1;;
      *) stop "app build failed before the migration rehearsal, nothing was restarted, see $L/app-build.log";;
    esac
  fi
  if rehearse; then say "$(grep -m1 '^REHEARSAL-OK' "$L/rehearsal.log")"; return 0; fi
  say "REHEARSAL FAILED: $(sed '/^--- the throwaway db/,$d' "$L/rehearsal.log" | grep -vE '^[[:space:]]*$' | tail -4 | tr '\n' ' ' | cut -c1-400)"
  stop "the migration rehearsal failed on this box's schema; the old containers are still serving, nothing was restarted, see $L/rehearsal.log"
}
# <<< functions

mkdir -p "$L" "$H/backups"
: > "$ST"
say "START tag=$TAG instance=$INSTANCE components=${COMPONENTS:-none}"

w=$(in_window); [ -n "$w" ] && stop "inside the $w UTC stop window; start after it"
busy=$(docker compose exec -T nextseek sh -c 'pgrep -af "manage.py (graph_sync --full|graph_sync --drift|nessie)" || true' </dev/null 2>/dev/null)
[ -n "$busy" ] && stop "busy inside nextseek: $busy"

git fetch -q origin || stop "git fetch failed"
[ "$(git rev-parse origin/dev)" = "$EXP" ] || stop "origin/dev is $(git rev-parse --short origin/dev), not the expected sha"
for p in $DISCARD; do git checkout -- "$p" 2>/dev/null; done   # the app's daily context refresh only
set_aside || stop "could not set the dirty $SET_ASIDE aside; nothing was reset past the failed file"
rm -f @@REFRESH_MARKER@@
git merge --ff-only "$EXP" >> "$L/pull.log" 2>&1 || stop "fast-forward refused, see $L/pull.log"
[ "$(git rev-parse HEAD)" = "$EXP" ] || stop "HEAD $(git rev-parse --short HEAD) is not the expected sha"
say "HEAD $(git log --oneline -1 | cut -c1-70)"

post_app(){
  if [ $DO_STATIC = 1 ]; then
    docker compose exec -T web uv run manage.py collectstatic --noinput > "$L/static.log" 2>&1 </dev/null   # the static volume is web's
    say "STATIC exit=$? $(tail -1 "$L/static.log" | cut -c1-100)"
  fi
  if [ $DO_LABS = 1 ]; then   # dev only; the file lives on the volume web and nextseek share (NEXTSEEK_LABS_FILE), so one write, no restart
    if [ -f /tmp/labs_db.json ]; then
      docker compose exec -T nextseek mkdir -p /media/context </dev/null
      docker compose cp /tmp/labs_db.json nextseek:/media/context/labs_db.json && say "LABS copied"
    else
      say "LABS source missing: /tmp/labs_db.json"
    fi
  fi
  docker compose exec -T nextseek mkdir -p /app/runs </dev/null
  docker compose exec -T web mkdir -p /app/runs </dev/null
}

# the range has a migration: build the app image and rehearse migrate on a copy of this box's schema before ANY
# component restarts; the app's turn in the loop below is then the restart (a cached build)
if [ $REHEARSE = 1 ] && ! build_and_rehearse; then   # its build failed and app is in continue_on_failure: skip the app
  COMPONENTS=$(echo " $COMPONENTS " | sed 's/ app / /; s/^ *//; s/ *$//')
fi
PENDING="$COMPONENTS"
for c in $COMPONENTS; do
  if rebuild "$c"; then
    say "REBUILT $c"
  else
    case "$CONTINUE_ON_FAILURE" in
      *" $c "*) say "FAILED $c, continuing (continue_on_failure): the old image stays, see $L/$(logname "$c").log";;
      *) stop "$c: no '$(success_line "$c")' line, see $L/$(logname "$c").log";;
    esac
  fi
  [ "$c" = app ] && post_app
  bad=$(judge "$L/$(logname "$c").log" "$c")
  if [ -n "$bad" ]; then
    if [ -n "$PENDING" ]; then stop "unexplained red after $c: $(echo $bad | cut -c1-300)"
    else say "FINDING red after the last rebuild ($c): $(echo $bad | cut -c1-300)"; fi
  fi
done

C=/app/NessieAI/chat_nextseek/src/chat_nextseek/context
{
  echo "CHECK http $(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/)"
  for k in nextseek nextseek-sidecar dmac-bedrock-proxy; do
    echo "CHECK container $k $(docker inspect -f 'status={{.State.Status}} restarts={{.RestartCount}} oom={{.State.OOMKilled}} started={{.State.StartedAt}}' $k 2>&1)"
  done
  # web and cc-spawner have no fixed name (a swap names the new web nextseek-web-N), so ask compose which container it is
  for s in web cc-spawner; do
    echo "CHECK container $s $(docker inspect -f 'status={{.State.Status}} restarts={{.RestartCount}} oom={{.State.OOMKilled}} started={{.State.StartedAt}}' $(docker compose ps -q $s </dev/null | head -1) 2>&1)"
  done
  # collectstatic and the DB probe log from web, migrate from the worker (nextseek)
  echo "CHECK boot_markers $({ docker compose logs --no-log-prefix web </dev/null; docker logs nextseek; } 2>&1 | grep -cE 'COLLECTSTATIC-FAILED|DB-UNREACHABLE|MIGRATE-FAILED')"
  echo "CHECK cc_runner $(docker compose exec -T web uv run --no-sync python -c 'from NessieAI.cc import cc_engine; print(cc_engine.cc_runner_available())' </dev/null 2>&1 | tail -1)"
  echo "CHECK labs_line $(docker compose logs --no-log-prefix web </dev/null 2>&1 | grep -F '[CONFIG][LABS]' | tail -1 | cut -c1-200)"
  echo "CHECK labs_file $(docker compose exec -T nextseek sh -c "stat -c %y /media/context/labs_db.json 2>/dev/null || echo missing" </dev/null)"
  echo "CHECK refresh_marker $(docker compose exec -T nextseek sh -c "stat -c %y $C/.context_db_refresh 2>/dev/null || echo missing" </dev/null)"
  # The op tools take the sidecar only when NEXTSEEK_CC_OPS_ROAD says sidecar (approach 1, piece 2); a build
  # without the switch (no NessieAI/cc/ops_road.py) always used it.
  road=$(docker compose exec -T nextseek sh -c 'test -f /app/NessieAI/cc/ops_road.py || { echo sidecar; exit 0; }; v=$(printf %s "${NEXTSEEK_CC_OPS_ROAD:-direct}" | tr -d " " | tr A-Z a-z); [ "$v" = sidecar ] && echo sidecar || echo direct' </dev/null 2>/dev/null | tail -1)
  [ -n "$road" ] || road=sidecar
  echo "CHECK ops_road $road"
  if [ "$road" = sidecar ]; then
    running=$(docker exec nextseek-sidecar sh -c 'grep -A3 "SIDECAR_OPS = frozenset" /app/sidecar/app/contract.py' 2>/dev/null | tr -d ' \n')
    repo=$(git show HEAD:NessieAI/docker/ns-sidecar/app/contract.py | grep -A3 "SIDECAR_OPS = frozenset" | tr -d ' \n')
    [ -n "$running" ] && [ "$running" = "$repo" ] && echo "CHECK sidecar_ops match" || echo "CHECK sidecar_ops differ"
  else
    echo "CHECK sidecar_ops skipped"
  fi
  for i in nextseek-nextseek:latest dmac-assistant:poc nextseek-ns-sidecar:latest nextseek-bedrock-proxy:latest nextseek-cc-spawner:latest; do
    echo "IMAGE $i $(docker image inspect -f '{{.Created}}' $i 2>&1)"
  done
  case " $COMPONENTS " in *" cc-agent "*)
    echo "CHECK cc_agent_versions $(timeout 90 docker run --rm --network none --entrypoint sh dmac-assistant:poc -c 'echo node $(node --version) claude $(claude --version 2>&1)' 2>&1 | tail -1)";;
  esac
@@MARKERS@@
  echo "CHECK memory $(free -g | awk '/^Mem:/{print "available_gib=" $7}')"
  docker stats --no-stream --format 'MEM {{.Name}} {{.MemUsage}}'
} > "$L/checks.log" 2>&1
say "CHECKS $(grep -m1 '^CHECK http' "$L/checks.log")"

CI_OK=1
if [ $DO_CI = 1 ]; then
  W=""; case " $COMPONENTS " in *" app "*) W="--wait-ready";; esac   # 300 s floor after an app restart
  ./startup.sh ci $W $CI_FLAGS > "$L/ci.log" 2>&1 </dev/null
  say "CI exit=$?"
  r=$(grep -E "CI passed|CI failed" "$L/ci.log" | tail -1 | sed -E 's/^[[:space:]]*[^[:space:]]+ //')
  say "CI_RESULT ${r:-none}"
  [ -z "$r" ] && CI_OK=0
  new=$(grep -E "^(FAILED|ERROR) " "$L/ci.log" | awk '{print $2}' | grep -vE "$KNOWN_CI_REDS")
  [ -n "$new" ] && { say "CI_NEW_REDS $(echo $new)"; CI_OK=0; }
  bad=$(judge "$L/ci.log" ci)
  [ -n "$bad" ] && say "FINDING red stack health in CI: $(echo $bad | cut -c1-300)"
fi

if [ $DO_NESSIE = 1 ]; then
  [ $CI_OK = 1 ] || stop "CI is not green apart from the known reds; the paid Nessie step did not start"
  # a refused model id silently moves every call to its fallback (F1), so a paid run needs every id proven reachable;
  # the check's yellow "!" (not proven) is never seen by judge(), so require the green line itself (2026-09-28)
  grep -qE '✓ model ids reachable' "$L/ci.log" 2>/dev/null || stop "model ids reachable is not green in CI (or CI did not run); the paid Nessie step did not start"
  m=$(docker stats --no-stream --format '{{.MemUsage}}' seek | awk '{print $1}'); say "SEEK_MEM $m"
  case "$m" in *GiB) g=${m%GiB}
    if [ "${g%.*}" -ge "$SEEK_RESTART_GIB" ] && [ "$SEEK_RESTART_OK" = 1 ]; then
      docker compose restart seek > /dev/null 2>&1
      for i in $(seq 1 24); do s=$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/); [ "$s" = 200 ] || [ "$s" = 302 ] && break; sleep 10; done
      say "SEEK restarted (http $s)"
    fi;;
  esac
  set -a; . "$H/.config/nextseek/ci.env"; set +a        # never echo these
  docker compose exec -T nextseek mkdir -p /app/runs </dev/null
  for f in $CASES; do
    RUN=$INSTANCE-${f%.json}
    cp "$IN/$f" "$L/$f" || { say "CASES missing $f"; continue; }
    docker cp "$L/$f" nextseek:/app/runs/$f
    case "$f" in   # a *-member.json file runs as the non-admin smoke login, every other as the admin (2026-10-05)
      *-member.json) LOGIN=member U=${CI_SMOKE_USER:-} PW=CI_SMOKE_PASS;;
      *) LOGIN=admin U=${CI_WRITE_USER:-} PW=CI_WRITE_PASS;;
    esac
    [ -n "$U" ] || { say "CASES no $LOGIN login in ci.env for $f"; continue; }
    say "NESSIE_START run=$RUN utc=$(date -u +%FT%TZ) login=$LOGIN"
    docker compose exec -T -e "$PW" nextseek uv run manage.py nessie --tier full \
      --cases /app/runs/$f --user "$U" --password-env "$PW" $NESSIE_FLAGS \
      --out /app/runs/$RUN </dev/null > "$L/nessie-$RUN.log" 2>&1
    say "NESSIE_EXIT run=$RUN exit=$? utc=$(date -u +%FT%TZ)"
    docker cp nextseek:/app/runs/$RUN "$L/" > /dev/null 2>&1
    docker cp nextseek:/app/runs/$RUN "$H/backups/" > /dev/null 2>&1
  done
fi
say ALL_DONE
