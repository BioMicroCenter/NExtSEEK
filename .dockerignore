# chat_nextseek is installed via local-path uv source (pyproject.toml [tool.uv.sources]).
# Once it goes public, switch to git+hash and add `chat_nextseek/` back here.
# For now we COPY the dir into the image but skip its heavy / stateful subtrees.
chat_nextseek/.venv/
chat_nextseek/.git/
chat_nextseek/outputs/
chat_nextseek/old/
chat_nextseek/__pycache__/
chat_nextseek/**/__pycache__/
chat_nextseek/.python-version
chat_nextseek/.claude/
chat_nextseek/.mcp.json

# Python build / runtime caches
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local outputs and seed-data dumps
outputs/
logs/
*.sql

# Git internals (build-context root)
.git/
.gitignore
