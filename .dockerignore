# chat_nextseek and dmac_assistant are installed from local-path uv sources
# (pyproject.toml [tool.uv.sources]) under NessieAI/. We COPY the tree into the
# image but skip heavy, stateful or machine-local subtrees, at any depth.
**/.venv/
**/.mcp.json
**/.claude/
NessieAI/chat_nextseek/.git/
NessieAI/chat_nextseek/outputs/
NessieAI/chat_nextseek/old/
# Only the unit's own copy: a root .python-version would steer `uv sync` in the
# Dockerfile, so it is deliberately not matched at every depth.
NessieAI/chat_nextseek/.python-version
# Pre-move location. After a git pull a box can still hold untracked leftovers
# here (.venv, outputs, .mcp.json); nothing tracked lives here any more.
chat_nextseek/
# Frozen records, never read at runtime.
NessieAI/history/
# The app image has no npm step (the chat bundle is committed under static/).
**/node_modules/
# NessieAI/tests/ is deliberately NOT excluded: the live router reads
# NessieAI/tests/nessie_tests/corpus.json, and the in-container test lanes need
# the tests. test_build_context_env_guard.py pins this.

# Python build / runtime caches
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local outputs and seed-data dumps
outputs/
logs/
*.sql

# Git internals (build-context root)
.git/
.gitignore

# Local agent state / committed skills — never needed inside the image
.claude/

# Local runtime config / secrets — provided at runtime, never needed in the image:
#   dmac/local_settings.py  is bind-mounted over /app/dmac/local_settings.py
#   docker/db.env, docker/nextseek.env  are injected via compose env_file
#   NessieAI/docker/bedrock-proxy/proxy-secret.env  is the proxy's env_file (real
#     Bedrock token); matched at any depth, so a moved directory stays covered
# Excluding them keeps plaintext config/secrets out of the `COPY . /app/` layer.
# PATTERNS, not exact names: ad-hoc operator copies (nextseek.env.bak.<date>,
# rotation backups, a root .env) carry the same secrets and must never enter the
# build context either. Committed *.example templates are re-included explicitly
# (last matching rule wins).
dmac/local_settings.py
docker/db.env*
docker/nextseek.env*
!docker/nextseek.env.example
**/proxy-secret.env*
# Re-include the one committed example by its exact path. A "!**/" exception makes BuildKit walk into every
# excluded directory looking for a match, and the harness writes root-only (0700) run folders under outputs/,
# so the whole app build failed with "open outputs/...: permission denied".
!NessieAI/docker/bedrock-proxy/proxy-secret.env.example
.env
**/.env
**/*.env.bak*

# Runtime-only context file: the labs the daily context export mines from SEEK institution
# titles (chat_nextseek.labs), and the temporary file of its atomic write. A host
# checkout's copy holds real lab titles and must never be baked into the app image.
NessieAI/chat_nextseek/src/chat_nextseek/context/labs_db.json
NessieAI/chat_nextseek/src/chat_nextseek/context/.labs_db.json.*.tmp
