# chat_nextseek is installed via local-path uv source (pyproject.toml [tool.uv.sources]).
# Once it goes public, switch to git+hash and add `chat_nextseek/` back here.
# For now we COPY the dir into the image but skip its heavy / stateful subtrees.
chat_nextseek/.venv/
chat_nextseek/.git/
chat_nextseek/outputs/
chat_nextseek/old/
chat_nextseek/__pycache__/
chat_nextseek/**/__pycache__/
chat_nextseek/.python-version
chat_nextseek/.claude/
chat_nextseek/.mcp.json

# Python build / runtime caches
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local outputs and seed-data dumps
outputs/
logs/
*.sql

# Git internals (build-context root)
.git/
.gitignore

# Local agent state / committed skills — never needed inside the image
.claude/

# Local runtime config / secrets — provided at runtime, never needed in the image:
#   dmac/local_settings.py  is bind-mounted over /app/dmac/local_settings.py
#   docker/db.env, docker/nextseek.env  are injected via compose env_file
#   docker/bedrock-proxy/proxy-secret.env  is the proxy's env_file (real Bedrock token)
# Excluding them keeps plaintext config/secrets out of the `COPY . /app/` layer.
# PATTERNS, not exact names: ad-hoc operator copies (nextseek.env.bak.<date>,
# rotation backups, a root .env) carry the same secrets and must never enter the
# build context either. Committed *.example templates are re-included explicitly
# (last matching rule wins).
dmac/local_settings.py
docker/db.env*
docker/nextseek.env*
!docker/nextseek.env.example
docker/bedrock-proxy/proxy-secret.env*
!docker/bedrock-proxy/proxy-secret.env.example
.env
**/.env
**/*.env.bak*
