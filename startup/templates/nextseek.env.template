SEEK_HOST="seek"
SEEK_HOSTNAME="http://seek:3000"
# Browser-reachable SEEK base URL for links rendered into HTML. Rendered from
# the per-instance value stored in startup/.instance.json (set it with
# `./startup.sh install --seek-public-url https://seek.your-domain.org`); a local
# install defaults to the published SEEK port. NOT the internal seek:3000.
# A hand-edit here is preserved: `install` reads this value back before
# re-rendering, so it is never reset to the local default.
SEEK_PUBLIC_URL="${SEEK_PUBLIC_URL}"

NEXTSEEK_HOSTNAME="127.0.0.1:${NEXTSEEK_PORT}"
NEXTSEEK_NEO4J_PASSWORD="${NEO4J_PASSWORD}"
NEXTSEEK_NEO4J_HOST="neo4j"

DJANGO_SECRET_KEY="${DJANGO_SECRET_KEY}"
DJANGO_ALLOWED_HOSTS="127.0.0.1 localhost"
DJANGO_CSRF_TRUSTED_ORIGINS="${DJANGO_CSRF_TRUSTED_ORIGINS}"

# Public base URL (browser-reachable; derives from NEXTSEEK_HOSTNAME via
# docker compose env_file interpolation).
NEXTSEEK_BASE_URL="http://$NEXTSEEK_HOSTNAME"
# Container-INTERNAL transport URL for chat_nextseek's REST self-calls (they
# run inside the nextseek container, which listens on :8000 regardless of the
# published host port NEXTSEEK_PORT). ChatConfig prefers this over
# NEXTSEEK_BASE_URL; must NOT derive from NEXTSEEK_HOSTNAME — a port-bumped
# install (e.g. :8001) would self-call a port nothing listens on (Step 7d).
NEXTSEEK_INTERNAL_BASE_URL="http://127.0.0.1:8000"
LOG_DIR="/app/logs"
NEXTSEEK_OUTPUTS_DIR="/app/outputs"
CATALOG_FILE="/app/chat_nextseek/agent_model_catalog.json"

# Real LLM keys go here. Startup leaves placeholders; the chat features
# stay disabled until you fill these in.
GCP_API_KEY="SET_IN_LOCAL_ENV"
AWS_BEARER_TOKEN_BEDROCK="SET_IN_LOCAL_ENV"
FDH_API="SET_IN_LOCAL_ENV"

# Per-turn spend cap for a Container-CC turn. 0 disables the cap entirely.
# This is a SECURITY CONTROL, not just a cost knob: architecture.md lists it
# alongside the segmented network and the zero-credential agent as one of the
# per-turn limits on an autonomous container. Raise it deliberately.
#
# 0.50 is the code default in cc_engine.py and is right for demo and chat use.
# It is NOT enough for the file-heavy CC ops: in the 2026-07-29 probe run all
# three of `pipeline_output_reingest` (x2) and the bulk metadata export died on
# `error_max_budget_usd` at 168s, 120s and 77s, so those ops could not be
# evaluated at all. A test instance exercising reingest wants ~3.00.
NEXTSEEK_CC_MAX_BUDGET_USD="0.50"

SESSION_DB_TYPE="mysql"
SESSION_DB_HOST=$MYSQL_HOST
SESSION_DB_USER=$MYSQL_USER
SESSION_DB_PASSWORD=$MYSQL_PASSWORD
SESSION_DB_NAME=$NEXTSEEK_MYSQL_DATABASE

MYSQL_HOST_PROD=$MYSQL_HOST
MYSQL_PROD_PASSWORD=$MYSQL_PASSWORD

MYSQL_HOST_DEV=$MYSQL_HOST
MYSQL_DEV_PASSWORD=$MYSQL_PASSWORD

NEO4J_URI="neo4j://$NEXTSEEK_NEO4J_HOST"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=$NEXTSEEK_NEO4J_PASSWORD
