# Maintainer-only secrets for dump-db.
# Copy this to dump-source.env (gitignored) and fill in real values.
# Point it at a SCRUBBED copy (see README.md, refresh/run.sh dump writes its own), never straight at a live box:
# the repo is public and a raw dump carries every account, session and token.

MYSQL_HOST_DEV=fairdata-dev.example.com
MYSQL_USER=SET_LOCAL_ONLY
MYSQL_DEV_PASSWORD=SET_LOCAL_ONLY
MYSQL_PORT=3306
# Optional: the client that writes the dump, e.g. a MySQL 8 container's own (then MYSQL_HOST_DEV=127.0.0.1):
# MYSQLDUMP="docker exec seek-mysql mysqldump"

NEO4J_URI=neo4j+s://nextseek-dev.example.com
NEO4J_USER=SET_LOCAL_ONLY
NEO4J_PASSWORD=SET_LOCAL_ONLY
NEO4J_DATABASE=nextseekdev
