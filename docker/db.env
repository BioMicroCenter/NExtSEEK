# db is the name of the MySQL Docker container. Don't change.
MYSQL_HOST="db" 

# Set to your desired MySQL root password
MYSQL_ROOT_PASSWORD="seek_root"

# Set to your preferred seek database name
MYSQL_DATABASE="seek_docker"

# Set to your preferred seek database username
MYSQL_USER="seek_db_user"

# Set to your preferred seek database password
MYSQL_PASSWORD="seek_db_password"
