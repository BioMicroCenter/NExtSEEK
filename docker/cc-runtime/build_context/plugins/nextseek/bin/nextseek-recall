#!/bin/sh
# nextseek-recall — fetch a prior NS turn's raw rows by turn_id (§4.C).
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/_nextseek_common.sh"

TURN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --turn) TURN="$2"; shift 2 ;;
    --turn=*) TURN="${1#--turn=}"; shift ;;
    --help)
      echo "Usage: nextseek-recall --turn <N>"
      echo ""
      echo "Fetch a prior NS turn's raw result rows from the live chat session."
      echo "Materializes rows to /data/scratch/recall/turn-<N>.json and prints"
      echo "a manifest JSON line to stdout."
      exit 0
      ;;
    *) nextseek_die 3 "unknown arg: $1" ;;
  esac
done
[ -n "$TURN" ] || nextseek_die 3 "missing --turn"

exec python "$SCRIPT_DIR/_nextseek_runner.py" --agent recall --turn "$TURN"
