SEEK_HOST="seek" # seek is the name of the SEEK Docker container. Don't change.
SEEK_HOSTNAME="http://seek:3000" # SEEK public hostname

NEXTSEEK_HOSTNAME="127.0.0.1:8000" # NExtSEEK public hostname
NEXTSEEK_NEO4J_PASSWORD="demopassword" # Password for the neo4j instance. Make sure it matches the one in docker-compose.yml
NEXTSEEK_NEO4J_HOST="neo4j" # neo4j is the name of the neo4j Docker container. Don't change.

# DJANGO_DEBUG="true" # Debug mode is ON only for 1/true/yes (case-insensitive, whitespace-stripped); anything else (absent, empty, 0, false, no, off) is OFF
# DJANGO_SESSION_COOKIE_DOMAIN="nextseek.example.com" # Set to your domain. Leave commented when testing locally
DJANGO_SECRET_KEY="CHANGE_ME" # Django secret key. Generate one.
DJANGO_ALLOWED_HOSTS="127.0.0.1 localhost" # Space-separated list of Django allowed hosts
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:8000 http://127.0.0.1:8000" # Space-separated list of trusted origins

# chat_nextseek-specific settings. A lot of redundancy.
# Update chat_nextseek to reuse existing environment variables
# from docker/db.env.

# Public base URL (browser-reachable; derives from NEXTSEEK_HOSTNAME via
# docker compose env_file interpolation).
NEXTSEEK_BASE_URL="http://${NEXTSEEK_HOSTNAME}"
# Container-INTERNAL transport URL for chat_nextseek's REST self-calls (they
# run inside the nextseek container, which listens on :8000 regardless of the
# published host port). ChatConfig prefers this over NEXTSEEK_BASE_URL; must
# NOT derive from NEXTSEEK_HOSTNAME.
# RUNBOOK: before adding this var to a PRE-EXISTING install's nextseek.env,
# confirm dmac/local_settings.py carries the internal-URL guard in its PROD
# overlay (env pop + config_map). A pre-guard hand-maintained overlay lets
# this var silently point the PROD ChatConfig at the dev backend —
# regenerate the file from startup/templates/local_settings.py.template
# first. `startup doctor` (and install's final health checks) flags the bad
# combination (prod overlay guard).
NEXTSEEK_INTERNAL_BASE_URL="http://127.0.0.1:8000"
LOG_DIR="/app/logs"
NEXTSEEK_OUTPUTS_DIR="/app/outputs"
CATALOG_FILE="/app/chat_nextseek/agent_model_catalog.json"
# Safe default: preserve the legacy single-router path until an operator has
# activated a compatible posterior generation and explicitly enables it.
NEXTSEEK_POSTERIOR_ROUTING_ENABLED="0"

# API keys consumed by chat_nextseek. Fill in real values in your local
# docker/nextseek.env (gitignored), NEVER in this template.
GCP_API_KEY="SET_IN_LOCAL_ENV"
AWS_BEARER_TOKEN_BEDROCK="SET_IN_LOCAL_ENV"
FDH_API="SET_IN_LOCAL_ENV"

SESSION_DB_TYPE="mysql"
SESSION_DB_HOST=$MYSQL_HOST
SESSION_DB_USER=$MYSQL_USER
SESSION_DB_PASSWORD=$MYSQL_PASSWORD
SESSION_DB_NAME=$NEXTSEEK_MYSQL_DATABASE

# Docker MySQL replaces "dev" target. Prod target also points at docker for now;
# the *_PROD block + frontend toggle will be added in a follow-up.
MYSQL_HOST_PROD=$MYSQL_HOST
MYSQL_PROD_PASSWORD=$MYSQL_PASSWORD

MYSQL_HOST_DEV=$MYSQL_HOST
MYSQL_DEV_PASSWORD=$MYSQL_PASSWORD

NEO4J_URI="neo4j://${NEXTSEEK_NEO4J_HOST}"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=$NEXTSEEK_NEO4J_PASSWORD

# Container-CC (assistant) per-project/per-user trees (G7-10). Persisted in the
# external named Docker volume below (created by `./startup.sh install`) — NOT a
# host bind, so no manual host mkdir/chmod is required. Override only to point at
# a differently-named external volume; the mount point inside the container is
# DMAC_USER_ROOT_MOUNT. Do NOT set a host-directory root (the old DMAC_USER_ROOT
# host-bind model is retired).
DMAC_CC_USERS_VOLUME="dmac-cc-users"
DMAC_USER_ROOT_MOUNT="/dmac/users"

# ── SEEK OAuth2 (issue #16) ───────────────────────────────────────────────
# Off by default. While off, the OAuth views 404 and login behaves exactly as
# it did before this feature existed, so leaving this block untouched is safe.
#
# To enable, you must first register a Doorkeeper application on the SEEK
# instance and set SEEK_OAUTH_REDIRECT_URI to the callback URL you registered
# there -- Doorkeeper compares it byte for byte, and it must be https on a real
# hostname (it rejects localhost and plain http).
SEEK_OAUTH_ENABLED="0"
SEEK_OAUTH_CLIENT_ID=""
SEEK_OAUTH_CLIENT_SECRET=""
SEEK_OAUTH_REDIRECT_URI=""

# Scope string, passed to SEEK verbatim. Left empty because which scopes SEEK
# exposes -- and which the operations NExtSEEK performs require -- has to be
# confirmed against your instance.
SEEK_OAUTH_SCOPE=""

# Encryption keys for tokens at rest: comma-separated urlsafe-base64 Fernet
# keys, the first used to encrypt and all tried when decrypting. Required when
# SEEK_OAUTH_ENABLED is on. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: prepend a new key, restart, and remove the old one only once every
# token predating the rotation has expired.
SEEK_OAUTH_TOKEN_KEYS=""

# Optional. The authorize URL defaults to SEEK_PUBLIC_URL + /oauth/authorize
# (browser-facing) and the token URL to the internal SEEK_URL + /oauth/token
# (server-to-server). Set these only to override that derivation.
#SEEK_OAUTH_AUTHORIZE_URL=""
#SEEK_OAUTH_TOKEN_URL=""

#SEEK_OAUTH_REVOKE_ON_LOGOUT="0"
#SEEK_OAUTH_HTTP_TIMEOUT="10"
