SEEK_HOST="seek" # seek is the name of the SEEK Docker container. Don't change.
SEEK_HOSTNAME="http://seek:3000" # SEEK public hostname
SEEK_PUBLIC_URL="http://localhost:3000" # Browser-reachable SEEK base URL for links, NOT the internal seek:3000. ./startup.sh install --seek-public-url sets it and keeps a hand-set value

NEXTSEEK_HOSTNAME="127.0.0.1:8000" # NExtSEEK public hostname
NEXTSEEK_NEO4J_PASSWORD='demopassword' # Password for the neo4j instance; single quotes keep a $ literal. Must match NEO4J_PASSWORD in the root .env
NEXTSEEK_NEO4J_HOST="neo4j" # neo4j is the name of the neo4j Docker container. Don't change.

# DJANGO_DEBUG="true" # Debug mode is ON only for 1/true/yes (case-insensitive, whitespace-stripped); anything else (absent, empty, 0, false, no, off) is OFF
# DJANGO_SESSION_COOKIE_DOMAIN="nextseek.example.com" # Set to your domain. Leave commented when testing locally
DJANGO_SECRET_KEY="CHANGE_ME" # Django secret key. Generate one.
DJANGO_ALLOWED_HOSTS="127.0.0.1 localhost" # Space-separated list of Django allowed hosts. ./startup.sh install keeps a hand-set value
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:8000 http://127.0.0.1:8000" # Space-separated list of trusted origins. ./startup.sh install keeps a hand-set value and adds the loopback pair for its port
# DJANGO_SECURE_COOKIES="1" # Secure flag on the session and CSRF cookies. Turn on once the box is served over https
# DJANGO_TRUST_X_FORWARDED_PROTO="1" # Trust the edge's X-Forwarded-Proto. Only where the edge overwrites it
# DJANGO_CORS_ALLOWED_ORIGINS="" # Space-separated origins allowed to call /nextseek_api/ cross-origin

# chat_nextseek-specific settings. A lot of redundancy.
# Update chat_nextseek to reuse existing environment variables
# from docker/db.env.

# Public base URL (browser-reachable; derives from NEXTSEEK_HOSTNAME via
# docker compose env_file interpolation).
NEXTSEEK_BASE_URL="http://${NEXTSEEK_HOSTNAME}"
# Container-INTERNAL transport URL for chat_nextseek's REST self-calls (they
# run inside the nextseek container, which listens on :8000 regardless of the
# published host port). ChatConfig prefers this over NEXTSEEK_BASE_URL; must
# NOT derive from NEXTSEEK_HOSTNAME.
# RUNBOOK: before adding this var to a PRE-EXISTING install's nextseek.env,
# confirm dmac/local_settings.py carries the internal-URL guard in its PROD
# overlay (env pop + config_map). A pre-guard hand-maintained overlay lets
# this var silently point the PROD ChatConfig at the dev backend —
# regenerate the file from startup/templates/local_settings.py.template
# first. `startup doctor` (and install's final health checks) flags the bad
# combination (prod overlay guard).
NEXTSEEK_INTERNAL_BASE_URL="http://127.0.0.1:8000"
LOG_DIR="/app/logs"
NEXTSEEK_OUTPUTS_DIR="/app/outputs"
CATALOG_FILE="/app/NessieAI/chat_nextseek/agent_model_catalog.json"
# Safe default: preserve the legacy single-router path until an operator has
# activated a compatible posterior generation and explicitly enables it.
NEXTSEEK_POSTERIOR_ROUTING_ENABLED="0"

# JevLevROUTING (laya in front of the router). Both OFF by default: shadow
# logs a laya answer next to BAML's and never routes; live must equal the
# revision in NessieAI/router/laya_calibration.json (never 1/true/yes).
# A box that lacks these lines reads as off. LAYA_API_KEY is shared with the
# sidecar's own docker/laya.env.
NESSIE_LAYA_SHADOW="0"
NESSIE_LAYA_LIVE=""
LAYA_API_KEY="SET_IN_LOCAL_ENV"

# Semantic shortlist tuning (chat_nextseek config.py), commented at the code
# defaults. The app image bakes the embedding models and sets
# SENTENCE_TRANSFORMERS_HOME and HF_HUB_OFFLINE itself: leave both unset here. A
# SEMANTIC_MODEL_NAME the image does not bake logs an ERROR and the shortlist
# falls back to lexical; nothing downloads (docker/README.md "Embedding models").
# SEMANTIC_ENDPOINTS_ENABLED="0"
# SEMANTIC_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
# SEMANTIC_RATIO="0.7"
# SEMANTIC_MIN_K="10"
# SEMANTIC_MAX_K="80"

# API keys consumed by chat_nextseek. Fill in real values in your local
# docker/nextseek.env (gitignored), NEVER in this template.
GCP_API_KEY="SET_IN_LOCAL_ENV"
AWS_BEARER_TOKEN_BEDROCK="SET_IN_LOCAL_ENV"
FDH_API="SET_IN_LOCAL_ENV"

# Per-turn spend cap for a Container-CC turn; 0 disables it. A security control,
# not just a cost knob. 0.50 suits chat use; the file-heavy CC ops want ~3.00.
NEXTSEEK_CC_MAX_BUDGET_USD="0.50"
# Hard ceiling (seconds) on one Container-CC turn; the Debug panel's turn-length override is clamped to it.
NEXTSEEK_CC_TIMEOUT_HARD_MAX="180"

SESSION_DB_TYPE="mysql"
SESSION_DB_HOST=$MYSQL_HOST
SESSION_DB_USER=$MYSQL_USER
SESSION_DB_PASSWORD=$MYSQL_PASSWORD
SESSION_DB_NAME=$NEXTSEEK_MYSQL_DATABASE

# Docker MySQL replaces "dev" target. Prod target also points at docker for now;
# the *_PROD block + frontend toggle will be added in a follow-up.
MYSQL_HOST_PROD=$MYSQL_HOST
MYSQL_PROD_PASSWORD=$MYSQL_PASSWORD

MYSQL_HOST_DEV=$MYSQL_HOST
MYSQL_DEV_PASSWORD=$MYSQL_PASSWORD

NEO4J_URI="neo4j://${NEXTSEEK_NEO4J_HOST}"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=$NEXTSEEK_NEO4J_PASSWORD

# Container-CC (assistant) per-project/per-user trees (G7-10). Persisted in the
# external named Docker volume dmac-cc-users (created by `./startup.sh install`),
# NOT a host bind, so no manual host mkdir/chmod is required. docker-compose.yml
# sets the volume name (DMAC_CC_USERS_VOLUME, with INSTANCE_PREFIX) in the app's
# environment, which wins over this file, so it is not set here. The mount point
# inside the container is DMAC_USER_ROOT_MOUNT. Do NOT set a host-directory root
# (the old DMAC_USER_ROOT host-bind model is retired).
DMAC_USER_ROOT_MOUNT="/dmac/users"

# graph_sync: whether a sync removes a sample's IN_STUDY links SEEK no longer holds. Unset (or add) only adds links;
# follow also removes them, archived first. Set it by hand only once this box's study merge is done, in the order
# nextseek_api/graph_sync/README.md "Study nodes and IN_STUDY" gives; a reinstall keeps it once set.
# NEXTSEEK_GRAPH_SYNC_STUDY_LINKS=follow

# Sample downloads: seconds the Neo4j lineage lookup may run before the workbook falls back to Parent;
# a WARNING naming this key is the signal to raise it. Unset is 5.
# NEO4J_TIMEOUT_SECONDS=5
