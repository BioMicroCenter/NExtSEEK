# OI-3 Bedrock auth-proxy secret env — TEMPLATE (committed; key NAMES only).
#
# Copy this to `bedrock-proxy/proxy-secret.env` (gitignored) and fill in the
# values. That real file holds the institutional Bedrock bearer token and is
# injected into the proxy container ONLY at runtime via compose `env_file:` —
# it is NEVER baked into the image (gate G6) and MUST NOT be committed.
#
#   cp bedrock-proxy/proxy-secret.env.example bedrock-proxy/proxy-secret.env
#   # then edit bedrock-proxy/proxy-secret.env and set the two values below
#
# AWS_BEARER_TOKEN_BEDROCK — the institutional Bedrock bearer token (ABSK…).
#   The proxy re-attaches it as `Authorization: Bearer …` on the way upstream.
# AWS_REGION — the Bedrock region; fixes the upstream host at config load.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
