SEEK_HOST="seek" # seek is the name of the SEEK Docker container. Don't change.
SEEK_HOSTNAME="https://seek.example.com" # SEEK public hostname

NEXTSEEK_HOSTNAME="nextseek.example.com" # NExtSEEK public hostname
NEXTSEEK_NEO4J_PASSWORD="neo4j_password" # Password for the neo4j instance. Make sure it matches the one in docker-compose.yml
NEXTSEEK_NEO4J_HOST="neo4j" # neo4j is the name of the neo4j Docker container. Don't change.

# DJANGO_DEBUG="True" # Set to anything to set Django to debug mode
# DJANGO_SESSION_COOKIE_DOMAIN="nextseek.example.com" # Set to your domain. Leave commented when testing locally
DJANGO_SECRET_KEY="fkjfmsalkflksamflkdsafms" # Django secret key. Generate one.
DJANGO_ALLOWED_HOSTS="127.0.0.1" # Space-separated list of Django allowed hosts
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:8000 http://127.0.0.1:8000" # Space-separated list of trusted origins

# chat_nextseek-specific settings. A lot of redundancy.
# Update chat_nextseek to reuse existing environment variables
# from docker/db.env.

NEXTSEEK_BASE_URL="https://${NEXTSEEK_HOSTNAME}"
LOG_DIR="/path/to/log/dir/inside/nextseek/container"
NEXTSEEK_OUTPUTS_DIR="/path/to/outputs/dir/inside/nextseek/container"
CATALOG_FILE="/app/agent_model_catalog.json"

GCP_API_KEY="API KEY HERE"
AWS_BEARER_TOKEN_BEDROCK="TOKEN HERE"

SESSION_DB_TYPE="mysql"
SESSION_DB_HOST=$MYSQL_HOST
SESSION_DB_USER=$MYSQL_USER
SESSION_DB_PASSWORD=$MYSQL_PASSWORD
SESSION_DB_NAME=$NEXTSEEK_MYSQL_DATABASE

MYSQL_HOST_PROD=$MYSQL_HOST
MYSQL_PROD_PASSWORD=$MYSQL_PASSWORD

MYSQL_HOST_DEV=""
MYSQL_DEV_PASSWORD=""

NEO4J_URI="neo4j://${NEXTSEEK_NEO4J_HOST}"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=$NEXTSEEK_NEO4J_PASSWORD
