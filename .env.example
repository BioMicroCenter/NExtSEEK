# Repo-root environment file, read by docker compose for ${VAR} interpolation
# in docker-compose.yml. Copy to `.env` and fill in. `.env` is gitignored.
#
#     cp .env.example .env
#
# NOT the same as docker/nextseek.env or docker/db.env: those are passed INTO
# containers, while this one is consumed by compose itself when it renders the
# compose file. A value needed by both has to appear in both.

# Seeds the Neo4j credential when the neo4j-data volume is first created.
# Compose fails fast if this is unset, rather than falling back to a default
# that every install would share.
#
# Must match NEO4J_PASSWORD and NEXTSEEK_NEO4J_PASSWORD in docker/nextseek.env,
# or the app cannot reach the graph.
#
# On an EXISTING install this value is not what the database uses: the password
# already lives in the volume. Rotate it explicitly, see
# docs/neo4j-programmatic-access.md.
NEO4J_PASSWORD=change-me-before-first-start

# Host port for the published nginx container. Bound to 127.0.0.1 in
# docker-compose.yml; put your own TLS-terminating reverse proxy in front.
#NEXTSEEK_PORT=8000

# --- Per-container memory caps -------------------------------------------------
# Each is `deploy.resources.limits.memory` plus an equal `memswap_limit`, so a
# runaway process is killed inside its own container instead of taking the host.
#
# The compose defaults are sized for the smallest box we run and DO NOT add up to
# any host: they bound one runaway, not the sum. Set these per box. A box whose
# total must fit lowers NEXTSEEK_MEMORY first, since 16G is headroom for the
# search path rather than steady-state need (about 6 GiB at rest).
#
# A changed cap takes effect when that service is recreated, not on a rebuild.
#
# 30 GiB workstation (totals 28G):
#NEXTSEEK_MEMORY=10G
# 46 GiB box: leave NEXTSEEK_MEMORY at its 16G default and raise the SEEK caps.
#SEEK_MEMORY=4G
#SEEK_WORKERS_MEMORY=3G
#NEO4J_MEMORY=6G
#SOLR_MEMORY=2G
#SEEK_DB_MEMORY=2G
#SIDECAR_MEMORY=1G

# Optional: the APOC plugin for Neo4j (off by default). The image already carries the jar,
# so this loads it on the next `docker compose up -d --no-deps neo4j`. Name only read-only
# families: the loaders (apoc.load, apoc.import), writers (apoc.periodic, apoc.create,
# apoc.refactor) and the dynamic Cypher runner (apoc.cypher) stay unloaded.
#NEO4J_PLUGINS=["apoc"]
#NEO4J_PROCEDURES_ALLOWLIST=db.*,dbms.*,tx.*,fleetManagement.*,apoc.path.*,apoc.meta.*,apoc.text.*,apoc.coll.*,apoc.agg.*,apoc.map.*,apoc.number.*,apoc.convert.*,apoc.date.*,apoc.temporal.*,apoc.node.*,apoc.label.*,apoc.any.*,apoc.math.*,apoc.stats.*
