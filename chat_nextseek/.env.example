LOG_DIR="outputs"
CATALOG_FILE="agent_model_catalog.json"
CONTEXT_DIR="src/chat_nextseek/context"
PROMPTS_DIR="src/chat_nextseek/prompts"
GCP_API_KEY="KEY"
NEXTSEEK_BASE_URL="https://nextseek-dev.mit.edu/"
API_USER="USER"
API_PASS="PASSWORD"

SESSION_DB_TYPE="sqlite"
SESSION_DB_PATH="db.sqlite"

# Semantic catalog shortlist (entity-side hybrid retrieval).
# Both default OFF — flip after E2E validates accuracy (see
# docs/superpowers/plans/2026-05-21-semantic-shortlist.md).
SEMANTIC_SHORTLIST_ENABLED="false"     # sampletypes + assays via SemanticIndex
SEMANTIC_ENDPOINTS_ENABLED="false"     # parser API-endpoint shortlister (scaffold only)
SEMANTIC_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
SEMANTIC_RATIO="0.7"                   # keep items with score >= ratio * top_score
SEMANTIC_MIN_K="10"                    # always include at least N items
SEMANTIC_MAX_K="80"                    # never include more than N items
