{
  "report_type": "PRIDE",
  "description": "PRIDE / ProteomeXchange submission summary JSON template aligned to the ProteomeXchange Submission Summary File Format v2.2.1.",
  "format": {
    "version": "2.2.1",
    "source_document": "pride.pdf",
    "output_type": "tab-delimited PRIDE submission summary file",
    "field_separator": "tab",
    "encoding": "UTF-8 preferred",
    "case_sensitive": true,
    "date_format": "ISO 8601",
    "decimal_separator": ".",
    "line_prefixes": {
      "metadata": "MTD",
      "file_mapping_header": "FMH",
      "file_mapping_entry": "FME",
      "sample_metadata_header": "SMH",
      "sample_metadata_entry": "SME",
      "comment": "COM"
    },
    "cv_param_format": {
      "serialization": "[CV label, accession, name, value]",
      "template": {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      },
      "notes": [
        "Leave unavailable CV fields empty within the four-part structure.",
        "User params are also allowed in this same four-part structure when CV terms cannot be given."
      ]
    }
  },
  "project_metadata": {
    "*submitter_name": null,
    "*submitter_email": null,
