        "name": null,
        "value": null
      }
    ],
    "*instrument": [
      {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      }
    ],
    "**modification": [
      {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      }
    ],
    "additional": [
      {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      }
    ],
    "pubmed_id": [],
    "resubmission_px": null,
    "reanalysis_px": []
  },
  "file_mapping": [
    {
      "*file_id": null,
      "*file_type": null,
      "*file_path": null,
      "**file_mapping": []
    }
  ],
  "sample_metadata": [
    {
      "*file_id": null,
      "*species": [
        {
          "cv_label": null,
