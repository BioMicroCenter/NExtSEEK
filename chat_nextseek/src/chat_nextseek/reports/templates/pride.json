    "other_omics_link": [],
    "*keywords": [],
    "*submission_type": null,
    "*experiment_type": [
      {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      }
    ],
    "**reason_for_partial": null,
    "*species": [
      {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      }
    ],
    "*tissue": [
      {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      }
    ],
    "cell_type": [
      {
        "cv_label": null,
        "accession": null,
        "name": null,
        "value": null
      }
    ],
    "disease": [
      {
        "cv_label": null,
