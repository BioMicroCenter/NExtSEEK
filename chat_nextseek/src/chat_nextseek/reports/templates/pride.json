  "notes": [
    "Populate values for the PRIDE submission summary file. Required fields are prefixed with * and conditional fields are prefixed with **.",
    "Repeated MTD fields should become separate metadata lines in the final tab-delimited submission file.",
    "All file names in the submission must be unique.",
    "For COMPLETE submissions, provide RAW and RESULT files; if RESULT files are mzIdentML 1.1, PEAK files are also required.",
    "For PARTIAL submissions, provide RAW files and corresponding SEARCH engine output files.",
    "Sample metadata applies to RESULT files and should be serialized as SMH/SME rows. The PRIDE PDF shows this for COMPLETE submissions; the PARTIAL example does not include a sample metadata section.",
    "Use controlled vocabulary terms wherever possible, especially for species, tissue, cell type, disease, instrument, and protein modifications."
  ],
  "schema": {
    "template_source": {
      "file": "pride.pdf",
      "title": "ProteomeXchange Submission Summary File Format",
      "version": "2.2.1",
      "dated": "August 9th 2016"
    },
    "submission_variants": {
      "COMPLETE": {
        "description": "Requires RAW files and RESULT files in PRIDE XML 2.1 or mzIdentML 1.1 format.",
        "required_file_types": [
          "raw",
          "result"
        ],
        "conditional_requirements": [
          "If RESULT files are mzIdentML 1.1, PEAK files used directly in the search are also required.",
          "RESULT rows should map to the RAW files on which they are based.",
          "Sample metadata rows correspond to RESULT file_id values."
        ]
      },
      "PARTIAL": {
        "description": "Requires RAW files and corresponding SEARCH engine output files.",
        "required_file_types": [
          "raw",
          "search"
        ],
        "conditional_requirements": [
          "reason_for_partial should explain why a COMPLETE submission was not possible.",
          "reason_for_partial should mention the search engine and/or pipeline used to generate the results.",
          "SEARCH rows should map to the RAW files on which they are based."
        ]
      }
    },
    "controlled_vocabularies": {
