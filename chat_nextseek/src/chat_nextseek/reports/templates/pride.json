    "sections": {
      "project_metadata": {
        "description": "Project-level metadata lines serialized with the MTD prefix. Repeated values become repeated MTD lines.",
        "fields": {
          "*submitter_name": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "First name and surname of the submitter."
          },
          "*submitter_email": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Submitter email address; also used as the login username to ProteomeXchange and for dataset ownership."
          },
          "*submitter_affiliation": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Institute or university affiliation of the submitter."
          },
          "*lab_head_name": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Principal investigator or lab head name. Duplicate submitter info here if they are the same person."
          },
          "*lab_head_email": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Principal investigator or lab head email address."
          },
          "*lab_head_affiliation": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Institute or university affiliation of the principal investigator or lab head."
          },
          "*submitter_pride_login": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "PRIDE account username. Submitters need to have a PRIDE account."
          },
          "*project_title": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Title of the project being submitted."
          },
          "*project_description": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Short public description or abstract of the experiment.",
            "validation_hints": [
              "Minimum 50 characters",
              "Maximum 5000 characters"
            ]
          },
          "project_tag": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of strings",
            "description": "Repository-assigned project tags used when the dataset is part of a larger project."
          },
          "*sample_processing_protocol": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Short description of the sample processing protocol.",
            "validation_hints": [
              "Minimum 50 characters",
              "Maximum 5000 characters"
            ]
          },
          "*data_processing_protocol": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Short description of the data processing protocol.",
            "validation_hints": [
              "Minimum 50 characters",
              "Maximum 5000 characters"
            ]
          },
          "other_omics_link": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of strings",
            "description": "Links or short statements pointing to related omics datasets generated by the same study."
          },
          "*keywords": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "array of strings",
            "description": "Keywords describing dataset content and experiment type. Serialize as a comma-separated string in the final submission.",
            "validation_hints": [
              "A minimum of three keywords is recommended"
            ]
          },
          "*submission_type": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "allowed_values": [
              "COMPLETE",
              "PARTIAL"
            ],
            "description": "Submission completeness category based on the types of files being submitted."
          },
          "*experiment_type": {
            "required": "required",
            "multiplicity": "1..N",
            "expected_value": "array of CV params",
            "description": "Experiment type CV terms."
          },
          "**reason_for_partial": {
            "required": "conditional",
            "multiplicity": "0..1",
            "expected_value": "string",
            "description": "Explain why a COMPLETE submission was not possible.",
            "required_when": "submission_type = PARTIAL"
          },
          "*species": {
            "required": "required",
            "multiplicity": "1..N",
            "expected_value": "array of CV params",
            "description": "Species represented in the dataset.",
            "ontology": "NEWT only"
          },
          "*tissue": {
            "required": "required",
            "multiplicity": "1..N",
            "expected_value": "array of CV params",
            "description": "Tissue terms for the dataset. If no tissue applies, use the special PRIDE tissue-not-applicable CV term.",
            "ontology": "BTO"
          },
          "cell_type": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of CV params",
            "description": "Cell type terms for the dataset.",
            "ontology": "CL"
          },
          "disease": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of CV params",
            "description": "Disease terms for the dataset.",
            "ontology": "DOID"
          },
          "quantification": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of CV params",
            "description": "Quantification technique terms recommended from the PRIDE ontology."
          },
          "*instrument": {
            "required": "required",
            "multiplicity": "1..N",
            "expected_value": "array of CV params",
            "description": "Instrument model terms.",
            "ontology": "MS (PSI-MS)"
          },
          "**modification": {
            "required": "conditional",
            "multiplicity": "1..N",
            "expected_value": "array of CV params",
            "description": "Protein modification terms. If no PTMs were reported, use the special no-PTMs CV term.",
            "ontology": "PSI-MOD or UNIMOD",
            "required_when": "Required for PARTIAL submissions; optional for COMPLETE submissions"
          },
          "additional": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of CV params or user params",
            "description": "Additional parameters describing the submission."
          },
          "pubmed_id": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of strings",
            "description": "PubMed IDs assigned to related publications. One ID per line in final serialization."
          },
          "resubmission_px": {
            "required": "optional",
            "multiplicity": "0..1",
            "expected_value": "string",
            "description": "Original ProteomeXchange accession when resubmitting a previously submitted dataset."
          },
          "reanalysis_px": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of strings",
            "description": "ProteomeXchange accessions for datasets that are being reanalyzed."
          }
        }
      },
      "file_mapping": {
        "description": "Tabular section serialized with one FMH header row followed by FME rows describing files and relationships.",
        "columns": {
          "*file_id": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "integer or string integer",
            "description": "Unique file ID as a consecutive non-negative integer starting with 1."
          },
          "*file_type": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Predefined PRIDE file type.",
            "allowed_values": [
              "result",
              "raw",
              "peak",
              "search",
              "quant",
              "gel",
              "fasta",
              "spectrum_library",
              "ms_image_data",
              "optical_image",
              "other"
            ]
          },
          "*file_path": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "string",
            "description": "Absolute path of the file."
          },
          "**file_mapping": {
            "required": "conditional",
            "multiplicity": "1 for mapped derived files",
            "expected_value": "array of file_id values",
            "description": "IDs of files related to this file. RESULT files in COMPLETE submissions and SEARCH files in PARTIAL submissions should list the RAW file IDs on which they are based.",
            "required_when": "Derived rows such as RESULT or SEARCH need mappings"
          }
        },
        "supported_file_types": {
          "result": {
            "description": "Result files in mzIdentML 1.1 or PRIDE XML 2.1.",
            "required_when": "COMPLETE",
            "notes": [
              "If using mzIdentML 1.1, PEAK files directly used in the search are mandatory."
            ]
          },
          "raw": {
            "description": "Mass spectrometer output files such as binary files, mzML, mzXML, or mzData.",
            "required_when": "All submissions"
          },
          "peak": {
            "description": "Processed peak list files such as MGF, dta, ms2, pkl, or heavily processed mzML/mzXML/mzData files.",
            "required_when": "COMPLETE with mzIdentML result files"
          },
          "search": {
            "description": "Search engine output files such as Mascot DAT, pep.xml, or prot.xml.",
            "required_when": "PARTIAL"
          },
          "quant": {
            "description": "Quantification analysis output files such as MaxQuant outputs.",
            "required_when": "Optional"
          },
          "gel": {
            "description": "Gel image files such as TIF, JPG, PNG, or GIF.",
            "required_when": "Optional"
          },
          "fasta": {
            "description": "Sequence database files containing protein sequences used by the search engine.",
            "required_when": "Optional"
          },
          "spectrum_library": {
            "description": "Spectrum library used during the analysis.",
            "required_when": "Optional"
          },
          "ms_image_data": {
            "description": "Mass spectrometry imaging data such as imzML or hdr files.",
            "required_when": "Optional"
          },
          "optical_image": {
            "description": "Optical image files.",
            "required_when": "Optional"
          },
          "other": {
            "description": "Other files relevant to the submission, such as scripts.",
            "required_when": "Optional"
          }
        },
        "validation_hints": [
          "All submitted file names must be unique.",
          "Serialize one FMH header line before FME rows."
        ]
      },
      "sample_metadata": {
        "description": "Tabular section serialized with one SMH header row followed by SME rows. Each row corresponds to a RESULT file_id and its sample details.",
        "applicability": "Used for RESULT files. Shown in the COMPLETE example; not shown in the PARTIAL example because that example has SEARCH rather than RESULT files.",
        "columns": {
          "*file_id": {
            "required": "required",
            "multiplicity": "1",
            "expected_value": "integer or string integer",
            "description": "File ID of the RESULT entry described by this sample row."
          },
          "*species": {
            "required": "required",
            "multiplicity": "1..N",
            "expected_value": "array of CV params",
            "description": "Species term(s) for this RESULT file.",
            "ontology": "NEWT"
          },
          "*tissue": {
            "required": "required",
            "multiplicity": "1..N",
            "expected_value": "array of CV params",
            "description": "Tissue term(s) for this RESULT file.",
            "ontology": "BTO"
          },
          "cell_type": {
            "required": "optional",
            "multiplicity": "0..N",
            "expected_value": "array of CV params",
            "description": "Cell type term(s) for this RESULT file.",
            "ontology": "CL"
