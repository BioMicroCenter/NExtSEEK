# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

dmac/local_settings.py
local_settings.py
.DS_Store

# Real env files are gitignored — secrets must never land in git.
# See docker/nextseek.env.example for the template.
docker/nextseek.env
docker/db.env
# Ad-hoc backup copies of rendered env files (nextseek.env.bak.<date>, …) —
# same secrets, same rule, any depth.
*.env.bak*

# Bedrock auth-proxy real secret env (holds AWS_BEARER_TOKEN_BEDROCK). Never
# tracked; injected into the proxy container only at runtime via compose
# env_file: (gate G6). See docker/bedrock-proxy/proxy-secret.env.example.
docker/bedrock-proxy/proxy-secret.env
internal_docs/
.cursor/
# .claude/ is local agent state — ignored except the committed project skills.
.claude/*
!.claude/skills/
duckdb/
embedding_models/
*.swp
setup-celery-worker.sh
outputs
CLAUDE.md
# The cc-agent image's in-container CLAUDE.md is a required Dockerfile COPY
# input (committed-but-generated; refresh via `python -m
# build_tools.ingest_nextseek_docs`). Carve it out of the bare rule above so
# clean clones can build the image.
!docker/cc-runtime/container/CLAUDE.md
.python-version
.serena/
.venv_uv/data/
1-NHP-Template-240909.xlsx
.codex/
.*_stage/
*.codex 
scripts/investigate_duplicates/outputs/
show

# Per-instance startup state (per-clone, not shared).
startup/.instance.json
startup/.ghcr-push-state.json

# Generated BAML router client (regenerate via baml-cli generate --from dmac_assistant/baml_src)
dmac_assistant/src/dmac_assistant/router/baml_client/

# Local design specs + plans (working docs, not part of the public repo).
# Excluded level-by-level so a single file can be re-included below; git will not descend
# into a directory excluded outright, which makes a bare negation inside it a no-op.
docs/superpowers/*
!docs/superpowers/specs/
docs/superpowers/specs/*
# Exception: this design spec is deliberately tracked. The repo is PUBLIC, so it carries no
# environment concretes and no reproduction detail for any unresolved platform issue.
!docs/superpowers/specs/2026-07-31-hibayes-eval-routing-design.md
!docs/superpowers/plans/
docs/superpowers/plans/*
# Exception: the implementation plan for the spec above is tracked alongside it, so the
# design and the work it implies travel together. Same public-repo review applied: no
# environment concretes, no credentials, no reproduction detail for any unresolved issue.
!docs/superpowers/plans/2026-07-31-hibayes-eval-routing.md

# SEEK filestore — too large for git (raw dir ~500MB; snapshot ~215MB, over
# GitHub's 100MB/file limit, and forks can't host LFS). The snapshot is hosted
# on S3 and downloaded on demand by the startup CLI. See startup/seed/README.md.
/filestore/
startup/seed/filestore.tar.gz

# Paired --bayesian run directories: manifests are ~800K and the artifacts/
# tree is ~325M per run. They are deliverables, not source, and a `git add -A`
# that swept one in would be very hard to undo.
nessie_bayes_*/

# graphify knowledge-graph output: ~62MB per build, of which graph.json alone is
# ~29MB. Regenerable from the tree at any time (`/graphify . --update`), so it is
# a local index, not source — and a `git add -A` that swept it in would be hard
# to undo on a repo this widely forked.
graphify-out/
