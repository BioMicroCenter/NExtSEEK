         "turns": [{"label": "main", "query": "How many samples are in the database?",
                    "pass_criteria": [{"field": "route", "op": "eq", "value": "nextseek_query"},
                                      {"field": "last_reply", "op": "mentions", "value": "50,889"}]}]},
        {"family": "nessie_green", "id": "green.mus_ndma",
