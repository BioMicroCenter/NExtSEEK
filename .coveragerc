[run]
# NessieAI holds the AI code that used to sit under nextseek_api (cc_assistant,
# eval, schema_rag, the assistant engine), so it is measured too. chat_nextseek
# and dmac_assistant are their own dists and were never in this report's scope;
# docker/ holds image build contexts, history/ is frozen and never run.
source =
    nextseek_api
    NessieAI
omit =
    nextseek_api/tests/*
    nextseek_api/*/tests/*
    nextseek_api/migrations/*
    */conftest.py
    nextseek_api/batch_upload/scripts/*
    NessieAI/tests/*
    NessieAI/history/*
    NessieAI/docker/*
    NessieAI/chat_frontend/*
    NessieAI/chat_nextseek/*
    NessieAI/dmac_assistant/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__
    raise NotImplementedError
    pass
    \.\.\.
    except ImportError
    if TYPE_CHECKING

fail_under = 0
show_missing = True

[html]
directory = htmlcov
