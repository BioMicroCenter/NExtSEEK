<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HiBayes Runtime Reliability — {{ report.generated_at }}</title>
<script src="{{ chartjs_cdn }}"></script>
<style>
:root {
    --bg: #FFFFFF;
    --surface: #F8F6FC;
    --surface-alt: #F0EDF5;
    --text: #1a1a2e;
    --text-muted: #6b7280;
    --text-light: #9ca3af;
    --accent: #A31F34;
    --accent-light: #c8102e;
    --success: #22c55e;
    --success-light: #dcfce7;
    --warning: #f59e0b;
    --warning-light: #fef3c7;
    --error: #ef4444;
    --error-light: #fee2e2;
    --border: #e5e7eb;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'SF Mono', 'Fira Code', Consolas, monospace;
}
* { box-sizing: border-box; }
body {
    margin: 0; padding: 32px;
    background: var(--surface); color: var(--text);
    font-family: var(--font); font-size: 14px; line-height: 1.55;
}
h1 { margin: 0 0 4px 0; font-size: 22px; }
h2 { margin: 0 0 12px 0; font-size: 16px; color: var(--text-muted); font-weight: 600; }
.container { max-width: 1280px; margin: 0 auto; }
.banner-warning {
    background: var(--warning-light); border: 1px solid var(--warning);
    color: #92400e; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px;
    font-size: 13px;
}
.banner-warning strong { color: #78350f; }
.banner-warning ul { margin: 6px 0 0 18px; padding: 0; }
.header {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 12px; padding: 24px; margin-bottom: 20px;
}
.header-meta {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 16px; margin-top: 16px;
}
.metric {
    background: var(--surface-alt);
    padding: 12px 16px; border-radius: 8px;
    border-left: 3px solid var(--accent);
}
.metric-label { color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; }
.metric-value { font-size: 22px; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.metric-note { font-size: 11px; color: var(--text-muted); margin-top: 2px; font-variant-numeric: tabular-nums; }
.run-meta { font-size: 12px; color: var(--text-muted); margin-top: 12px; font-family: var(--font-mono); }
.charts {
    display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;
}
.chart-card {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 12px; padding: 20px; height: 280px; position: relative;
}
.controls {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 12px; padding: 12px 16px; margin-bottom: 12px;
    display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
}
.controls input[type=search] {
    flex: 1; min-width: 240px; padding: 6px 10px;
    border: 1px solid var(--border); border-radius: 6px; font: inherit;
}
.table-card {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 12px; overflow: hidden;
}
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td {
    padding: 10px 12px; text-align: left; vertical-align: top;
    border-bottom: 1px solid var(--border);
}
th {
    background: var(--surface);
    font-weight: 600; color: var(--text-muted);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;
}
.row-summary { cursor: pointer; }
.row-summary:hover { background: var(--surface); }
.row-detail { display: none; background: var(--surface); }
.row-detail.open { display: table-row; }
.row-detail td { padding: 16px 24px; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.detail-block { background: var(--bg); padding: 12px; border-radius: 6px; border: 1px solid var(--border); }
.detail-block h3 { margin: 0 0 6px 0; font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
.diag-img { display: block; max-width: 100%; height: auto; margin-top: 8px; }
.pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; font-variant-numeric: tabular-nums; }
.pill.ok { background: var(--success-light); color: #166534; }
.pill.fail { background: var(--error-light); color: #991b1b; }
.pill.warn { background: var(--warning-light); color: #92400e; }
.pill.muted { background: var(--surface-alt); color: var(--text-muted); }
.num { font-variant-numeric: tabular-nums; text-align: right; }
footer { color: var(--text-light); font-size: 11px; margin-top: 24px; text-align: center; }
@media (max-width: 900px) {
    .charts, .header-meta, .detail-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="container">

{% if has_failures %}
<div id="diagnostics-banner" class="banner-warning">
    <strong>Diagnostic checkers reported failures.</strong> See the diagnostics
    section for details. Posterior estimates are still rendered (DD-10), but
    treat with caution.
    <ul>
    {% for name, info in report.diagnostics_summary.items() %}
        {% if info is mapping and info.get("status") == "fail" %}
        <li><code>{{ name }}</code>: {{ info.get("reason", "(no reason)") }}</li>
        {% endif %}
    {% endfor %}
    </ul>
</div>
{% endif %}

<header class="header">
    <h1>HiBayes Runtime Reliability</h1>
    <h2>{{ report.generated_at }}</h2>
    <div class="header-meta">
        <div class="metric">
            <div class="metric-label">Families</div>
            <div class="metric-value">{{ report.posteriors|length }}</div>
        </div>
        <div class="metric">
            <div class="metric-label">Total runs</div>
            <div class="metric-value">{{ report.aggregates|map(attribute='n_total')|sum }}</div>
        </div>
        <div class="metric">
            <div class="metric-label">Total successes</div>
            <div class="metric-value">{{ report.aggregates|map(attribute='n_success')|sum }}</div>
        </div>
        <div class="metric">
            <div class="metric-label">Reliable / Watch / Brittle / TooUncertain</div>
            <div class="metric-value">
                {% set rb = report.posteriors|selectattr('band','equalto',ReliabilityBand.Reliable)|list|length %}
                {% set wb = report.posteriors|selectattr('band','equalto',ReliabilityBand.Watch)|list|length %}
                {% set bb = report.posteriors|selectattr('band','equalto',ReliabilityBand.Brittle)|list|length %}
                {% set ub = report.posteriors|selectattr('band','equalto',ReliabilityBand.TooUncertain)|list|length %}
                {{ rb }} / {{ wb }} / {{ bb }} / {{ ub }}
            </div>
        </div>
    </div>
    <div class="run-meta">rendered_at_utc: {{ rendered_at_utc }}</div>
</header>

<section class="charts">
    <div class="chart-card"><canvas id="posteriorMeanChart"></canvas></div>
    <div class="chart-card"><canvas id="observedVsPosteriorChart"></canvas></div>
    <div class="chart-card"><canvas id="failureModeChart"></canvas></div>
    <div class="chart-card"><canvas id="riskChart"></canvas></div>
</section>

<div class="table-card">
<table>
<thead>
<tr>
    <th>Task family</th>
    <th>Band</th>
    <th class="num">n</th>
    <th class="num">success</th>
    <th class="num">observed</th>
    <th class="num">posterior mean</th>
    <th class="num">94% HDI</th>
    <th class="num">P(&lt;0.90)</th>
    <th class="num">P(&lt;0.80)</th>
    <th class="num">avg latency</th>
    <th class="num">avg cost</th>
</tr>
</thead>
<tbody>
{% for r in table_rows %}
<tr class="row-summary" data-family="{{ r.task_family }}">
    <td>{{ r.task_family }}</td>
    <td><span class="{{ r.pill_class }}">{{ r.band }}</span></td>
    <td class="num">{{ r.n_total|dash_for_none }}</td>
    <td class="num">{{ r.n_success|dash_for_none }}</td>
    <td class="num">{{ r.observed_success_rate|pct }}</td>
    <td class="num">{{ r.posterior_mean|pct }}</td>
    <td class="num">[{{ r.hdi_low|pct }}, {{ r.hdi_high|pct }}]</td>
    <td class="num">{{ r.p_success_lt_strong|pct }}</td>
    <td class="num">{{ r.p_success_lt_acceptable|pct }}</td>
    <td class="num">{{ r.avg_latency_seconds|fixed(1) }}s</td>
    <td class="num">{{ r.avg_cost_usd|money }}</td>
</tr>
<tr class="row-detail">
    <td colspan="11">
        <div class="detail-grid">
            <div class="detail-block">
                <h3>Failure breakdown</h3>
                <div>n_error: {{ r.n_error }}</div>
                <div>n_timeout: {{ r.n_timeout }}</div>
                <div>n_no_answer: {{ r.n_no_answer }}</div>
            </div>
            <div class="detail-block">
                <h3>80% HDI (from diagnostics)</h3>
                <div>low: {{ r.hdi_80_low|pct }}</div>
                <div>high: {{ r.hdi_80_high|pct }}</div>
                <div>posterior_median: {{ r.posterior_median|pct }}</div>
            </div>
        </div>
    </td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

{% if plot_inlines %}
<section class="charts" style="margin-top:20px;">
    {% for key, b64 in plot_inlines.items() %}
    <div class="chart-card" style="height:auto;">
        <h3 style="margin-top:0;">{{ key }}</h3>
        <img class="diag-img" alt="{{ key }}" src="data:image/png;base64,{{ b64 }}">
    </div>
    {% endfor %}
</section>
{% endif %}

<script type="application/json" id="{{ manifest_script_id }}">{{ manifest_json }}</script>

<script>
(function () {
    var manifest = JSON.parse(document.getElementById("{{ manifest_script_id }}").textContent);
    var chartData = {{ chart_data_json }};

    new Chart(document.getElementById("posteriorMeanChart"), {
        type: "bar",
        data: {
            labels: chartData.posteriorMean.families,
            datasets: [{ label: "posterior mean", data: chartData.posteriorMean.values }]
        },
        options: { plugins: { title: { display: true, text: "Posterior mean by family" } }, scales: { y: { min: 0, max: 1 } } }
    });

    new Chart(document.getElementById("observedVsPosteriorChart"), {
        type: "scatter",
        data: {
            datasets: [{
                label: "obs vs posterior",
                data: chartData.observedVsPosterior.families.map(function (f, i) {
                    return { x: chartData.observedVsPosterior.observed[i], y: chartData.observedVsPosterior.posterior[i] };
                })
            }]
        },
        options: { plugins: { title: { display: true, text: "Observed vs posterior" } }, scales: { x: { min: 0, max: 1 }, y: { min: 0, max: 1 } } }
    });

    new Chart(document.getElementById("failureModeChart"), {
        type: "bar",
        data: {
            labels: chartData.failureMode.families,
            datasets: [
                { label: "error", data: chartData.failureMode.n_error },
                { label: "timeout", data: chartData.failureMode.n_timeout },
                { label: "no_answer", data: chartData.failureMode.n_no_answer }
            ]
        },
        options: { plugins: { title: { display: true, text: "Failure modes by family" } }, scales: { x: { stacked: true }, y: { stacked: true } } }
    });

    new Chart(document.getElementById("riskChart"), {
        type: "bar",
        data: { labels: chartData.risk.families, datasets: [{ label: "P(success<0.80)", data: chartData.risk.values }] },
        options: { plugins: { title: { display: true, text: "Risk: P(success<acceptable_floor)" } }, scales: { y: { min: 0, max: 1 } } }
    });

    document.querySelectorAll("tbody").forEach(function (tbody) {
        tbody.addEventListener("click", function (e) {
            var row = e.target.closest(".row-summary");
            if (!row) return;
            var next = row.nextElementSibling;
            if (next && next.classList.contains("row-detail")) next.classList.toggle("open");
        });
    });
})();
</script>

<footer>HiBayes runtime-reliability report (DMAC Assistant)</footer>
</div>
</body>
</html>
